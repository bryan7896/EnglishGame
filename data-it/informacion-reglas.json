    "4": [
      {
        "titulo": "Artículos indeterminados (un, uno, una, un')",
        "introduccion": "El artículo indeterminado ('un/una' en español) también cambia según género y primera letra:\nMASCULINO: UN (delante de casi todo: un libro, un amico — 'un' nunca lleva apóstrofe), UNO (delante de s+consonante, z, gn, ps: uno studente, uno zaino).\nFEMENINO: UNA (delante de consonante: una casa), UN' (delante de vocal, con apóstrofe: un'amica, un'orologio no existe pero un'amica sí).",
        "ejercicio1": {
          "subtitulo": "Selecciona el artículo correcto",
          "preguntas": [
            {
              "texto": "¿Cuál es el artículo indeterminado correcto para 'amico' (amigo, masculino)?",
              "opciones": [
                {
                  "texto": "un amico",
                  "correcta": true,
                  "explicacion": "'Un' no lleva apóstrofe nunca, ni siquiera delante de vocal: un amico."
                },
                {
                  "texto": "un'amico",
                  "correcta": false,
                  "explicacion": "El apóstrofe en 'un'' es solo para el femenino, no para 'un' masculino."
                }
              ]
            },
            {
              "texto": "¿Cuál es el artículo indeterminado correcto para 'amica' (amiga, femenino)?",
              "opciones": [
                {
                  "texto": "una amica",
                  "correcta": false,
                  "explicacion": "Delante de vocal, el femenino 'una' se convierte en 'un'' con apóstrofe."
                },
                {
                  "texto": "un'amica",
                  "correcta": true,
                  "explicacion": "Correcto: femenino + vocal = un'amica (con apóstrofe)."
                }
              ]
            },
            {
              "texto": "¿Cuál es el artículo indeterminado correcto para 'studente' (estudiante)?",

    "3": [
      {
        "titulo": "Artículos determinados (il, lo, la, l', i, gli, le)",
        "introduccion": "El artículo determinado ('el/la' en español) cambia según el género y la primera letra de la palabra:\nMASCULINO singular: IL (il libro), LO (delante de s+consonante, z, gn, ps: lo studente, lo zaino), L' (delante de vocal: l'amico, l'orologio).\nFEMENINO singular: LA (la casa), L' (delante de vocal: l'amica).\nMASCULINO plural: I (i libri), GLI (plural de lo/l': gli studenti, gli amici).\nFEMENINO plural: LE (le case, le amiche).",
        "ejercicio1": {
          "subtitulo": "Selecciona el artículo correcto",
          "preguntas": [
            {
              "texto": "¿Cuál es el artículo correcto para 'treno' (tren)?",
              "opciones": [
                {
                  "texto": "il treno",
                  "correcta": true,
                  "explicacion": "'Treno' es masculino y empieza con consonante simple: il treno."
                },
                {
                  "texto": "lo treno",
                  "correcta": false,
                  "explicacion": "'Lo' se usa antes de s+consonante, z, gn, ps — no antes de 'tr'."
                }
              ]
            },
            {
              "texto": "¿Cuál es el artículo correcto para 'studente' (estudiante)?",
              "opciones": [
                {
                  "texto": "il studente",
                  "correcta": false,
                  "explicacion": "Antes de 's+consonante' se usa 'lo', no 'il'."
                },
                {
                  "texto": "lo studente",
                  "correcta": true,
                  "explicacion": "'Studente' empieza con 's+consonante' (st-), por eso se usa 'lo'."
                }
              ]
            },
            {
              "texto": "¿Cuál es el artículo correcto para 'amico' (amigo)?",
              "opciones": [
                {
                  "texto": "lo amico",
                  "correcta": false,
                  "explicacion": "Antes de vocal se usa 'l'', no 'lo'."
                },
                {
                  "texto": "l'amico",
                  "correcta": true,
                  "explicacion": "'Amico' empieza con vocal, por eso se usa 'l'' (elisión)."
                }
              ]
            },
            {
              "texto": "¿Cuál es el plural correcto de 'lo studente'?",
              "opciones": [
                {
                  "texto": "i studenti",
                  "correcta": false,
                  "explicacion": "El plural de 'lo' es 'gli', no 'i'."
                },
                {
                  "texto": "gli studenti",
                  "correcta": true,
                  "explicacion": "Correcto: el plural de 'lo' (y de 'l'') es siempre 'gli'."
                }
              ]
            }
          ]
        },
        "ejercicio2": {
          "subtitulo": "Completa con el artículo correcto",
          "banco": [
            "il",
            "lo",
            "la",
            "l'",
            "i",
            "gli",
            "le"
          ],
          "frases": [
            {
              "texto": "___ libro è nuovo",
              "respuesta": "il"
            },
            {
              "texto": "___ studente è italiano",
              "respuesta": "lo"
            },
            {
              "texto": "___ orologio è qui",
              "respuesta": "l'"
            },
            {
              "texto": "___ casa è grande",
              "respuesta": "la"
            },
            {
              "texto": "___ amici sono simpatici",
              "respuesta": "gli"
            }
          ]
        },
        "ejercicio3": {
          "subtitulo": "Traduce",
          "explicacion": "Incluye el artículo determinado correcto en tu respuesta.",
          "traducciones": [
            {
              "spanishWord": "el estudiante",
              "englishWord": "lo studente"
            },
            {
              "spanishWord": "el amigo",
              "englishWord": "l'amico"
            },
            {
              "spanishWord": "los amigos",
              "englishWord": "gli amici"
            }
          ]
        }
      }

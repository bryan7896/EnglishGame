                {
                  "texto": "uno studente",
                  "correcta": true,
                  "explicacion": "'Studente' empieza con 's+consonante', por eso se usa 'uno'."
                }
              ]
            },
            {
              "texto": "'Fiore' (flor) es masculino. ¿Cuál es el artículo indeterminado correcto?",
              "opciones": [
                {
                  "texto": "un fiore",
                  "correcta": true,

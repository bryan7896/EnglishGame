    "5": [
      {
        "titulo": "Género de los sustantivos",
        "introduccion": "En italiano, todos los sustantivos tienen género: masculino o femenino. La regla general es: las palabras que terminan en -O suelen ser MASCULINAS (il libro, il gatto) y las que terminan en -A suelen ser FEMENINAS (la casa, la ragazza). Pero hay una trampa: las palabras que terminan en -E pueden ser masculinas O femeninas, y hay que aprenderlas de memoria (il fiore = la flor, es masculino; la notte = la noche, es femenino). Además, el género en italiano NO siempre coincide con el género en español: 'la flor' es femenina en español pero 'il fiore' es masculino en italiano.",
        "ejercicio1": {
          "subtitulo": "Selecciona el género correcto",
          "preguntas": [
            {
              "texto": "¿Qué género tiene 'libro'?",
              "opciones": [
                {
                  "texto": "Masculino (il libro)",
                  "correcta": true,
                  "explicacion": "Termina en -O, es masculino: il libro."
                },
                {
                  "texto": "Femenino (la libro)",
                  "correcta": false,
                  "explicacion": "Las palabras en -O casi siempre son masculinas."
                }
              ]
            },
            {
              "texto": "¿Qué género tiene 'casa'?",
              "opciones": [
                {
                  "texto": "Masculino (il casa)",
                  "correcta": false,
                  "explicacion": "Las palabras en -A casi siempre son femeninas."
                },
                {
                  "texto": "Femenino (la casa)",
                  "correcta": true,
                  "explicacion": "Termina en -A, es femenino: la casa."
                }
              ]
            },
            {
              "texto": "'Fiore' (flor) termina en -E. ¿Cuál es su género real?",
              "opciones": [
                {
                  "texto": "Masculino (il fiore)",
                  "correcta": true,
                  "explicacion": "Aunque en español 'la flor' es femenina, en italiano 'il fiore' es masculino. Hay que memorizarlo."
                },
                {
                  "texto": "Femenino (la fiore)",
                  "correcta": false,
                  "explicacion": "Es una excepción: 'fiore' termina en -E pero es masculino."
                }
              ]
            },
            {
              "texto": "'Notte' (noche) también termina en -E. ¿Cuál es su género?",
              "opciones": [
                {
                  "texto": "Masculino (il notte)",
                  "correcta": false,
                  "explicacion": "'Notte' es femenino, aunque termine en -E."
                },
                {
                  "texto": "Femenino (la notte)",
                  "correcta": true,
                  "explicacion": "Correcto: la notte. Las palabras en -E hay que memorizarlas una por una."
                }
              ]
            }
          ]
        },
        "ejercicio2": {
          "subtitulo": "Clasifica: ¿masculino o femenino?",
          "banco": [
            "maschile",
            "femminile"
          ],
          "frases": [
            {
              "texto": "Il libro è ___",
              "respuesta": "maschile"
            },
            {
              "texto": "La casa è ___",
              "respuesta": "femminile"
            },
            {
              "texto": "Il fiore è ___",
              "respuesta": "maschile"
            },
            {
              "texto": "La notte è ___",
              "respuesta": "femminile"
            },
            {
              "texto": "Il gatto è ___",
              "respuesta": "maschile"
            }
          ]
        },
        "ejercicio3": {
          "subtitulo": "Traduce",
          "explicacion": "Presta atención al género de cada palabra en italiano.",
          "traducciones": [
            {

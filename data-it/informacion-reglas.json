                  "correcta": true,
                  "explicacion": "Correcto: noi parliamo (nosotros hablamos)."
                }
              ]
            },
            {
              "texto": "¿Cómo se dice 'ella trabaja' con lavorare?",
              "opciones": [
                {
                  "texto": "lei lavora",
                  "correcta": true,
                  "explicacion": "Correcto: lei lavora (ella trabaja) — mismo patrón que parlare: lavor-a."
                },
                {
                  "texto": "lei lavori",
                  "correcta": false,
                  "explicacion": "'Lavori' es la forma de 'tu' (tú), no de 'lei' (ella)."
                }
              ]
            },
            {
              "texto": "¿Cómo se dice 'ellos compran' con comprare?",

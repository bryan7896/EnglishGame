    "1": [
      {
        "titulo": "Presente del verbo Essere (ser/estar)",
        "introduccion": "'Essere' es el verbo más importante del italiano; significa 'ser' o 'estar'. Se usa para decir quién eres, de dónde eres, tu profesión o cómo eres. Conjugación en presente:\nio sono (yo soy) · tu sei (tú eres) · lui/lei è (él/ella es) · noi siamo (nosotros somos) · voi siete (vosotros sois) · loro sono (ellos son).\nEjemplo: 'Io sono italiano' (Yo soy italiano). 'Noi siamo amici' (Nosotros somos amigos).",
        "ejercicio1": {
          "subtitulo": "Selecciona la conjugación correcta",
          "preguntas": [
            {
              "texto": "¿Cómo se dice 'yo soy' con essere?",
              "opciones": [
                {
                  "texto": "io sono",
                  "correcta": true,
                  "explicacion": "Correcto: io sono (yo soy)."
                },
                {
                  "texto": "io sei",
                  "correcta": false,
                  "explicacion": "'Sei' es la forma de 'tu' (tú), no de 'io' (yo)."
                }
              ]
            },
            {
              "texto": "¿Cómo se dice 'nosotros somos' con essere?",
              "opciones": [
                {
                  "texto": "noi siete",
                  "correcta": false,
                  "explicacion": "'Siete' es la forma de 'voi' (vosotros), no de 'noi' (nosotros)."
                },
                {
                  "texto": "noi siamo",
                  "correcta": true,
                  "explicacion": "Correcto: noi siamo (nosotros somos)."
                }
              ]
            },
            {
              "texto": "¿Cómo se dice 'ella es' con essere?",
              "opciones": [
                {
                  "texto": "lei è",
                  "correcta": true,
                  "explicacion": "Correcto: lei è (ella es)."
                },
                {
                  "texto": "lei sono",
                  "correcta": false,
                  "explicacion": "'Sono' se usa con 'io' y con 'loro', no con 'lei'."
                }
              ]
            },
            {
              "texto": "¿Cómo se dice 'ellos son' con essere?",
              "opciones": [
                {
                  "texto": "loro sono",
                  "correcta": true,
                  "explicacion": "Correcto: loro sono (ellos son). Curiosamente, 'sono' se usa tanto para 'io' como para 'loro'."
                },
                {
                  "texto": "loro è",
                  "correcta": false,
                  "explicacion": "'È' es la forma de 'lui/lei' (él/ella), no de 'loro' (ellos)."
                }
              ]
            }
          ]
        },
        "ejercicio2": {
          "subtitulo": "Completa con la forma correcta de essere",
          "banco": [
            "sono",
            "sei",
            "è",
            "siamo",
            "siete"
          ],
          "frases": [
            {
              "texto": "Io ___ italiano",
              "respuesta": "sono"
            },
            {
              "texto": "Tu ___ spagnolo",
              "respuesta": "sei"
            },
            {
              "texto": "Lui ___ francese",
              "respuesta": "è"
            },
            {
              "texto": "Noi ___ amici",
              "respuesta": "siamo"
            },
            {
              "texto": "Voi ___ studenti",
              "respuesta": "siete"
            }
          ]
        },
        "ejercicio3": {
          "subtitulo": "Traduce",
          "explicacion": "Usa la forma correcta de essere en cada frase.",
          "traducciones": [
            {
              "spanishWord": "Yo soy italiano",
              "englishWord": "Io sono italiano"
            },
            {
              "spanishWord": "Ella es profesora",
              "englishWord": "Lei è insegnante"
            },
            {
              "spanishWord": "Nosotros somos amigos",
              "englishWord": "Noi siamo amici"
            }
          ]
        }
      }

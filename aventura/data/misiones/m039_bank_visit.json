      "personajes": [
        {
          "id": "hank",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "ben"
          },
          "ocupado": [
            {
              "quien": "hank",
              "texto": "Ben is at the second window."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "hank",
                "texto": "Good morning. How can I help you?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  42
                ],
                "opciones": [
                  {
                    "texto": "The money machine outside took my card.",
                    "ok": true
                  },
                  {
                    "texto": "Look. Japan is in Asia, near China."
                  },
                  {
                    "texto": "OK. I'll be free by three o'clock."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Oh no. So your card is still in the machine?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  41
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. The machine has my card.",
                    "ok": true
                  },
                  {
                    "texto": "I'm interested in learning new things."
                  },
                  {
                    "texto": "Sure. I'll make you some soup."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "OK. Do you know where to go?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  2
                ],
                "opciones": [
                  {
                    "texto": "No. Where should I go?",
                    "ok": true
                  },
                  {
                    "texto": "That's bad. Was the bed hard?"
                  },
                  {
                    "texto": "Yes. Has the mail arrived yet?"
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Talk to Ben. He's at the second window."
              }
            ]
          }
        },
        {
          "id": "george",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "george",
              "texto": "Banks! Always so slow!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "george",
                "texto": "Bryan! Are you taking money out too?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  42
                ],
                "opciones": [
                  {
                    "texto": "No. My card isn't working at the money machine.",
                    "ok": true
                  },
                  {
                    "texto": "By Friday? OK, it will be ready by then."
                  },
                  {
                    "texto": "Good. He can help us as fast as possible."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Oh dear. Good luck!"
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        },
        {
          "id": "ben",
          "rol": "target",
          "antes": {
            "quien": "ben",
            "texto": "One moment, please. I'm busy."
          },
          "dialogo": {
            "requiere": "hank_hablado",
            "pasos": [
              {
                "quien": "ben",
                "texto": "Good morning. What's the problem?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  2
                ],
                "opciones": [
                  {
                    "texto": "My card is in your machine. How can I get it back?",
                    "ok": true
                  },
                  {
                    "texto": "Is it the figure that was in the glass box?"
                  },
                  {
                    "texto": "No, I haven't seen it. Is it in the car?"
                  }
                ]
              },
              {
                "quien": "ben",
                "texto": "This is your bank card, isn't it?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  29
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes, it is. You can help me, can't you?",
                    "ok": true
                  },
                  {
                    "texto": "No, I haven't seen her yet. Where is she?"
                  },
                  {
                    "texto": "That's my phone case! But where is my phone?"
                  }
                ]
              },
              {
                "quien": "ben",
                "texto": "Of course. Can I see your passport, please?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  6
                ],
                "opciones": [
                  {
                    "texto": "Sure. Do I need to sign anything?",
                    "ok": true
                  },
                  {
                    "texto": "Yes, please. Could you take us home?"
                  },
                  {
                    "texto": "Sure. What do you want to know?"
                  }
                ]
              },
              {
                "quien": "ben",
                "texto": "Not now, thank you. The machine kept it because you wrote the wrong number."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  42
                ],
                "opciones": [
                  {
                    "texto": "Oh no! I forgot my secret number.",
                    "ok": true
                  },
                  {
                    "texto": "Sure. A sandwich and an orange juice."
                  },
                  {
                    "texto": "Over the holidays, I visited my friends."
                  }
                ]
              },
              {
                "quien": "ben",
                "texto": "How long have you had this card?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  34
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I've had it for two years.",
                    "ok": true
                  },
                  {
                    "texto": "His mother gave them to him."
                  },
                  {
                    "texto": "OK. I'll take it off now."
                  }
                ]
              },
              {
                "quien": "ben",
                "texto": "Don't worry. We'll give you a new card. You need to sign here."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  6
                ],
                "opciones": [
                  {
                    "texto": "Sure. Do I need to sign here too?",
                    "ok": true
                  },
                  {
                    "texto": "OK. Can you tell me when it arrives?"
                  },
                  {
                    "texto": "It's at ten thirty. How far is it?"
                  }
                ]
              },
              {
                "quien": "ben",
                "texto": "Yes. And you need to wait five days."
              },
              {
                "quien": "ben",
                "texto": "When do you need the money?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I need it by Friday.",
                    "ok": true
                  },
                  {
                    "texto": "I work as an engineer."
                  },
                  {
                    "texto": "We'll be walking in Japan!"
                  }
                ]
              },
              {
                "quien": "ben",
                "texto": "No problem. You'll have it by then.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  6
                ],
                "opciones": [
                  {
                    "texto": "OK. Do I need to come back here?",
                    "ok": true
                  },
                  {
                    "texto": "OK. Have you seen anybody near the kitchen?"
                  },
                  {
                    "texto": "No, not yet. Can you sing it again?"
                  }
                ]
              },
              {
                "quien": "ben",
                "texto": "No. We'll send it to your house."
              },
              {
                "quien": "ben",
                "texto": "Please write your address on this paper.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  22
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "OK. Is this the paper for the new card?",
                    "ok": true
                  },
                  {
                    "texto": "No, I'm not. It's a crazy story, isn't it?"
                  },
                  {
                    "texto": "Yes, please. Can you call my phone for me?"
                  }
                ]
              },
              {
                "quien": "ben",
                "texto": "Yes, it is. Thank you.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  2
                ],
                "opciones": [
                  {
                    "texto": "Great. When will it arrive?",
                    "ok": true
                  },
                  {
                    "texto": "Sure. Is it a chocolate cake?"
                  },
                  {
                    "texto": "Yes. Can you bring us some water?"
                  }
                ]
              },
              {
                "quien": "ben",
                "texto": "On Friday. Have a nice day!"
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }

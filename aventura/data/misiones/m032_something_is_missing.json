  "escenas": [
    {
      "id": "sala_museo",
      "titulo": "The museum",
      "fondo": "museo",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "hank",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "ruth"
          },
          "ocupado": [
            {
              "quien": "hank",
              "texto": "Ask Ruth. She saw something."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "hank",
                "texto": "Excuse me. Something was taken from the museum this morning."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  45
                ],
                "opciones": [
                  {
                    "texto": "Really? What was taken?",
                    "ok": true
                  },
                  {
                    "texto": "Wow. For twelve hours?"
                  },
                  {
                    "texto": "Really? How long had you been reading?"
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "A small stone figure. It was made two thousand years ago."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  5
                ],
                "opciones": [
                  {
                    "texto": "Is it the figure that was in the glass box?",
                    "ok": true
                  },
                  {
                    "texto": "Has it gone? When does the next one come?"
                  },
                  {
                    "texto": "No, I'm not. It's a crazy story, isn't it?"
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Yes. Ruth, who works here, saw something. Ask her."
              }
            ]
          }
        },
        {
          "id": "ruth",
          "rol": "target",
          "antes": {
            "quien": "ruth",
            "texto": "One moment, please."
          },
          "dialogo": {
            "requiere": "hank_hablado",
            "pasos": [
              {
                "quien": "ruth",
                "texto": "Hello. Are you helping Hank?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  5
                ],
                "opciones": [
                  {
                    "texto": "Yes. Did you see the person who took it?",
                    "ok": true
                  },
                  {
                    "texto": "If I pay now, will you write her name on it?"
                  },
                  {
                    "texto": "That's OK. Have you worked here for a long time?"
                  }
                ]
              },
              {
                "quien": "ruth",
                "texto": "I saw a woman in a red hat. She was near the glass box at ten."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  46
                ],
                "opciones": [
                  {
                    "texto": "She must be the one!",
                    "ok": true
                  },
                  {
                    "texto": "I'll be waiting behind the door."
                  },
                  {
                    "texto": "Yes. I enjoy reading before sleeping."
                  }
                ]
              },
              {
                "quien": "ruth",
                "texto": "Maybe. But Bella was here too, and she has a red hat."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  46
                ],
                "opciones": [
                  {
                    "texto": "It can't be Bella. She was with me at ten.",
                    "ok": true
                  },
                  {
                    "texto": "Don't worry. If you try again, you'll win one day."
                  },
                  {
                    "texto": "Wow! By then, you'll have been living here a long time."
                  }
                ]
              },
              {
                "quien": "ruth",
                "texto": "I saw her face. Do you want to know more?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  23
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. What did the woman look like?",
                    "ok": true
                  },
                  {
                    "texto": "Because they got their food before us."
                  },
                  {
                    "texto": "Are they late because of the storm?"
                  }
                ]
              },
              {
                "quien": "ruth",
                "texto": "She had short black hair and big glasses.",
                "refuerzo": true
              },
              {
                "quien": "ruth",
                "texto": "Look at the security camera in the office, too."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "oficina"
              }
            ]
          }
        },
        {
          "id": "bella",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "bella",
              "texto": "I hope they find it!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "bella",
                "texto": "Bryan! Is it true? The stone figure was taken?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  45
                ],
                "opciones": [
                  {
                    "texto": "Yes. It was taken this morning.",
                    "ok": true
                  },
                  {
                    "texto": "Any time! Next time, bring pizza for us!"
                  },
                  {
                    "texto": "Yes! Next time, I'll look at the sky."
                  }
                ]
              },
              {
                "quien": "bella",
                "texto": "Oh no! It was beautiful."
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        },
        {
          "id": "george",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "george",
              "texto": "In my time, things were different!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "george",
                "texto": "In my time, there was a guard in every room!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  5
                ],
                "opciones": [
                  {
                    "texto": "Hank is the guard who watches this room.",
                    "ok": true
                  },
                  {
                    "texto": "Yes! The man who works at the door helped us."
                  },
                  {
                    "texto": "Over the last year, I learned a lot of English."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Only one? Hmm!"
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        }
      ],

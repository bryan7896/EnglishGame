{
  "id": "m032",
  "titulo": "Something is missing",
  "titulo_es": "Algo falta en el museo",
  "objetivo": "Something is missing from the museum. Find out what happened.",
  "objetivo_es": "Falta algo en el museo. Descubre qué pasó.",
  "nivel": "B1",
  "resumen": "Desaparecio una figura de piedra del museo. Ayuda al guardia a descubrir que paso preguntando y mirando las camaras.",
  "musica_inicial": "home_loop",
  "reglas_juego": {

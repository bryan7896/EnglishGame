    {
      "id": "oficina",
      "titulo": "The security office",
      "fondo": "oficina",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "hank",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "hank",
                "texto": "This camera is checked every day. Look at the screen."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  45
                ],
                "opciones": [
                  {
                    "texto": "Was she seen by the camera?",
                    "ok": true
                  },
                  {
                    "texto": "Have you eaten any cake today?"
                  },
                  {
                    "texto": "Sure. Can I use your pen?"
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Yes, look! Who is that?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  5
                ],
                "opciones": [
                  {
                    "texto": "That's the woman who was wearing the red hat!",
                    "ok": true
                  },
                  {
                    "texto": "By next month, I'll have been working here a year."
                  },
                  {
                    "texto": "Did you see it? I had put it next to my cup."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "She's carrying a bag. The figure might be in it."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  46
                ],
                "opciones": [
                  {
                    "texto": "Yes! It might be in her bag.",
                    "ok": true
                  },
                  {
                    "texto": "For twenty minutes, during the first song."
                  },
                  {
                    "texto": "I don't know. I'll tell you later."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Wait... she's coming back! She's putting the figure on the table!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  45
                ],
                "opciones": [
                  {
                    "texto": "So the figure was returned! Great!",
                    "ok": true
                  },
                  {
                    "texto": "Because it's more fun with you!"
                  },
                  {
                    "texto": "No, I haven't called him yet."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Has anything else been taken?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  19
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No. Nothing else has been taken.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. After breakfast, lunch and dinner."
                  },
                  {
                    "texto": "OK. I won't make any noise."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Ha ha. Maybe she only wanted to look at it! Thank you, Bryan."
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }
      ],

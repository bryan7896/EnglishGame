    {
      "id": "sala",
      "titulo": "Linda's house",
      "fondo": "sala_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "linda",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "linda",
                "texto": "So, Bryan, tell me about this street."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  2
                ],
                "opciones": [
                  {
                    "texto": "Sure. What do you want to know?",
                    "ok": true
                  },
                  {
                    "texto": "So the station is on the left?"
                  },
                  {
                    "texto": "Great! Can it be checked every month?"
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Is there a supermarket near here?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  22
                ],
                "opciones": [
                  {
                    "texto": "Yes, there's a small supermarket on the corner.",
                    "ok": true
                  },
                  {
                    "texto": "Thank you! Please give them to him later."
                  },
                  {
                    "texto": "Thank you! You've given us a great night!"
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Great. And what about you? What do you do?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  2
                ],
                "opciones": [
                  {
                    "texto": "I'm a student. And where do you work?",
                    "ok": true
                  },
                  {
                    "texto": "Oh no. Has he gone to the doctor?"
                  },
                  {
                    "texto": "Do we need to pay for the card?"
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "I work at the city hospital. I'm a nurse."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  20
                ],
                "opciones": [
                  {
                    "texto": "Cool! My uncle works there, too.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, there are too many people."
                  },
                  {
                    "texto": "Good idea. That's the easiest way."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Really? What's his name?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  20
                ],
                "opciones": [
                  {
                    "texto": "George. He lives in the green house.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. It's next to the bus stop."
                  },
                  {
                    "texto": "Not much. Only half of a bottle."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Oh, I met him this morning! He has a nice dog."
              },
              {
                "quien": "linda",
                "texto": "How long have you lived on this street?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  34
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "We've lived here since I was a child.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, but there are too many people today."
                  },
                  {
                    "texto": "Good idea. And we can finish by midnight."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "I've just moved in. Have you met my cat yet?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  10
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No, I haven't seen her yet. Where is she?",
                    "ok": true
                  },
                  {
                    "texto": "The elevator is broken. Can it be repaired today?"
                  },
                  {
                    "texto": "Yes, please. Can you call my phone for me?"
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "She's sleeping upstairs. She's very quiet.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  2
                ],
                "opciones": [
                  {
                    "texto": "Why did you move to this street?",
                    "ok": true
                  },
                  {
                    "texto": "Yes. What did the woman look like?"
                  },
                  {
                    "texto": "Sure. Do I need to sign anything?"
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Because my new job is very close. And it's a quiet street."
              },
              {
                "quien": "linda",
                "texto": "It's a nice place to live, isn't it?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  29
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes, it is. The neighbors are nice, aren't they?",
                    "ok": true
                  },
                  {
                    "texto": "They're beautiful. When did she give them to you?"
                  },
                  {
                    "texto": "It's at ten thirty. How far is it?"
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Yes, they are! I'm very happy here.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  22
                ],
                "opciones": [
                  {
                    "texto": "Welcome! I hope you have a great time here.",
                    "ok": true
                  },
                  {
                    "texto": "If you bought it, we would have a party!"
                  },
                  {
                    "texto": "Can you give them to me? I can check."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Thank you, Bryan. And thank your mom for the cake!"
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }

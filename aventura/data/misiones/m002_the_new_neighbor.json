{
  "id": "m002",
  "titulo": "The new neighbor",
  "titulo_es": "La vecina nueva",
  "objetivo": "Meet your new neighbor and find out who she is.",
  "objetivo_es": "Conoce a tu vecina nueva y averigua quién es.",
  "nivel": "A2",
  "resumen": "Llega una vecina nueva a tu calle. Tu mama te pide llevarle un pastel. Pregunta donde vive, conocela y averigua quien es.",
  "musica_inicial": "street_loop",
  "reglas_juego": {
    "modal_reintento": {
      "color": "naranja",
      "opciones": 2
    },
    "tercer_error": "revelar_correcta_sin_puntos_y_a_repaso",

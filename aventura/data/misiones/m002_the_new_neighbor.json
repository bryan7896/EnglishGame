  "escenas": [
    {
      "id": "calle",
      "titulo": "Your street",
      "fondo": "ciudad_dia",
      "musica": "street_loop",
      "personajes": [
        {
          "id": "mom",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "lily"
          },
          "dialogo": {
            "pasos": [
              {
                "quien": "mom",
                "texto": "Bryan, can you help me? We have a new neighbor."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  2
                ],
                "opciones": [
                  {
                    "texto": "Really? What is her name?",
                    "ok": true
                  },
                  {
                    "texto": "But you still hope, right?"
                  },
                  {
                    "texto": "Thanks! Is it a long walk?"
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "I don't know. Please take her this cake and say hello."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  22
                ],
                "opciones": [
                  {
                    "texto": "Sure. Is it a chocolate cake?",
                    "ok": true
                  },
                  {
                    "texto": "Oh no! When did you get sick?"
                  },
                  {
                    "texto": "Yes. Has the mail arrived yet?"
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Yes, it is. Ask Lily. She knows everybody on this street."
              }
            ]
          }
        },
        {
          "id": "lily",
          "rol": "informante",
          "pista": {
            "marca": "linda"
          },
          "antes": {
            "quien": "lily",
            "texto": "Um... hi, Bryan. Is your mom looking for you?"
          },
          "ocupado": [
            {
              "quien": "lily",
              "texto": "Um... good luck, Bryan."
            },
            {
              "quien": "lily",
              "texto": "Linda is really nice. You'll see."
            }
          ],
          "dialogo": {
            "requiere": "mom_hablado",
            "pasos": [
              {
                "quien": "lily",
                "texto": "Hi, Bryan! Is that cake for me?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  22
                ],
                "opciones": [
                  {
                    "texto": "No, sorry. It's for the new neighbor.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. One ticket to River Town, please."
                  },
                  {
                    "texto": "You too. I really like this hotel."
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "Oh, Linda! She's really nice. She works at the hospital."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  2
                ],
                "opciones": [
                  {
                    "texto": "Where does she live?",
                    "ok": true
                  },
                  {
                    "texto": "Did you say tomorrow morning?"
                  },
                  {
                    "texto": "I still hope so!"
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "In the blue house, next to the big tree. She's in the garden now."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  20
                ],
                "opciones": [
                  {
                    "texto": "Great. She lives very near us, then.",
                    "ok": true
                  },
                  {
                    "texto": "Oh no! I forgot my secret number."
                  },
                  {
                    "texto": "Yes. I can't find my phone anywhere."
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "Can you see the blue house?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  39
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. It's on the corner, next to the tree.",
                    "ok": true
                  },
                  {
                    "texto": "I wanted to tell you, but you were cooking."
                  },
                  {
                    "texto": "If I had money, I would go to Japan."
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "Yes! And she has a white cat."
              }
            ]
          }
        },
        {
          "id": "george",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "george",
              "texto": "Say hello to your mother, my boy."
            },
            {
              "quien": "george",
              "texto": "My dog wants to go to the park."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "george",
                "texto": "Good morning, Bryan. Nice day, isn't it?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  20
                ],
                "opciones": [
                  {
                    "texto": "Yes. Your dog runs very fast!",
                    "ok": true
                  },
                  {
                    "texto": "Yes! At five, we'll be dancing!"
                  },
                  {
                    "texto": "No, I've never met one before!"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Ha ha, he loves the park. Who is that cake for?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  22
                ],
                "opciones": [
                  {
                    "texto": "It's for the woman in the blue house.",
                    "ok": true
                  },
                  {
                    "texto": "He works as a cook in a restaurant."
                  },
                  {
                    "texto": "Yes. I still hope the sun comes back."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Ah, the new neighbor. Say hello from me!"
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        },
        {
          "id": "linda",
          "rol": "target",
          "antes": {
            "quien": "linda",
            "texto": "Sorry, I'm very busy with these boxes right now."
          },
          "dialogo": {
            "requiere": "lily_hablado",
            "pasos": [
              {
                "quien": "linda",
                "texto": "Oh, hello! Can I help you?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  22
                ],
                "opciones": [
                  {
                    "texto": "Hi! I'm Bryan. I live in the white house.",
                    "ok": true
                  },
                  {
                    "texto": "By Friday? OK, it will be ready by then."
                  },
                  {
                    "texto": "I will. I don't want to get wet again."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Nice to meet you, Bryan. I'm Linda. Is that cake for me?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  20
                ],
                "opciones": [
                  {
                    "texto": "Yes. My mom makes the best cakes.",
                    "ok": true
                  },
                  {
                    "texto": "On the second floor? OK, thank you."
                  },
                  {
                    "texto": "For twenty minutes, during the first song."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "How nice! Please, come in. Let's have some tea."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "sala"
              }
            ]
          }
        }
      ],

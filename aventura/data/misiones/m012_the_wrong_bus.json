                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "We want to go to the university.",
                    "ok": true
                  },
                  {
                    "texto": "I didn't see anybody in the kitchen."
                  },
                  {
                    "texto": "Yes, I've taken it out. It's soft!"

                  {
                    "texto": "Hi! I need to order for four people."
                  },
                  {
                    "texto": "I had been working all week before this!"
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "Good. But bus number five has just left."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  15
                ],
                "opciones": [
                  {
                    "texto": "Oh no, it has left? When is the next one?",

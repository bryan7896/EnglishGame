                ]
              },
              {
                "quien": "sam",
                "texto": "Oh no. This bus doesn't go to the university.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  16
                ],
                "opciones": [
                  {
                    "texto": "How can we get to the university?",

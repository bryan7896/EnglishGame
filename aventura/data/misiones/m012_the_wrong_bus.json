                  {
                    "texto": "Yes! You can see my phone number here."
                  },
                  {
                    "texto": "I'll be waiting for my suitcase at home."
                  }
                ]
              },
              {
                "quien": "kenji",
                "texto": "Oh no! I took the wrong bus."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  35
                ],
                "opciones": [
                  {
                    "texto": "Me too! I was reading when I got on.",
                    "ok": true
                  },
                  {
                    "texto": "If you get lost again, I'll find you again!"
                  },
                  {
                    "texto": "Yes. It was used this morning, then it stopped."

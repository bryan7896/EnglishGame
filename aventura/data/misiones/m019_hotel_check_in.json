{
  "id": "m019",
  "titulo": "Hotel check-in",
  "titulo_es": "Llegada al hotel",
  "objetivo": "There is a problem with your room. Make it right.",
  "objetivo_es": "Hay un problema con tu habitación. Resuélvelo.",
  "nivel": "A2-B1",
  "resumen": "Llegas a un hotel y no encuentran tu reserva. Resuelvelo con la recepcionista y llega a tu habitacion.",
  "musica_inicial": "home_loop",
  "reglas_juego": {
    "modal_reintento": {
      "color": "naranja",
      "opciones": 2
    },
    "tercer_error": "revelar_correcta_sin_puntos_y_a_repaso",
    "texto_en_tercera_pulsacion": {
      "puntos": 0.5
    },
    "estrellas": {
      "3": {
        "max_errores": 2
      },
      "2": {
        "max_errores": 5
      },
      "1": {
        "max_errores": 99
      }
    },
    "monedas_por_turno_sin_error": 2
  },
  "escenas": [
    {
      "id": "lobby",
      "titulo": "The hotel",
      "fondo": "hotel_lobby",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "grace",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "grace",
                "texto": "Good evening. Welcome to the hotel. Do you have a reservation?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  41
                ],
                "opciones": [
                  {
                    "texto": "Yes. I have a room for two nights.",
                    "ok": true
                  },
                  {
                    "texto": "A piece of cake and an apple juice."
                  },
                  {
                    "texto": "Yes! You sing really well. I sing badly!"
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "Have you stayed with us before?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  28
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No, I've never stayed here before.",
                    "ok": true
                  },
                  {
                    "texto": "Sure. I'll do the dishes later."
                  },
                  {
                    "texto": "OK. I'll put them down here."
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "Do you want a room with a view?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  5
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes, a room that has a view of the sea.",
                    "ok": true
                  },
                  {
                    "texto": "No. All the bags have gone, and mine isn't here."
                  },
                  {
                    "texto": "Good. By six, we'll have been working for ten hours!"
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "Hmm... I'm sorry. I can't find your name."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  29
                ],
                "opciones": [
                  {
                    "texto": "I paid online. That's strange, isn't it?",
                    "ok": true
                  },
                  {
                    "texto": "Great! Can it be checked every month?"
                  },
                  {
                    "texto": "Yes. What did the woman look like?"
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "Yes, it is. Why are you visiting the city?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  49
                ],
                "opciones": [
                  {
                    "texto": "Because I have a job interview tomorrow.",
                    "ok": true
                  },
                  {
                    "texto": "We had been walking in the park."
                  },
                  {
                    "texto": "No, sorry. It's for the new neighbor."
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "Oh! Here it is. But your room isn't ready because of a problem with the water."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  29
                ],
                "opciones": [
                  {
                    "texto": "But I can wait here, can't I?",
                    "ok": true
                  },
                  {
                    "texto": "Is it going to rain a lot?"
                  },
                  {
                    "texto": "Can you call a taxi for us?"
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "Of course. Now it's ready. Here is your key."
              },
              {
                "quien": "grace",
                "texto": "Your room is on the second floor.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  39
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "On the second floor? OK, thank you.",
                    "ok": true
                  },
                  {
                    "texto": "I don't know. I'll tell you later."
                  },
                  {
                    "texto": "The money machine outside took my card."
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "The pool is open now.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  42
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Great. Do I need a towel for the pool?",
                    "ok": true
                  },
                  {
                    "texto": "They're beautiful. When did she give them to you?"
                  },
                  {
                    "texto": "A little. How do I get to the station?"
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "No, there are towels at the pool.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  41
                ],
                "opciones": [
                  {
                    "texto": "Thank you. Where is the elevator, please?",
                    "ok": true
                  },
                  {
                    "texto": "Oh no! When did you get sick?"
                  },
                  {
                    "texto": "Please! Can you give us one minute?"
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "On your left. Room two hundred and five."
              }
            ],
            "al_terminar": [
              {
                "habilita": "elevator"
              }
            ]
          }
        },
        {
          "id": "george",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "george",
              "texto": "Enjoy your stay, my boy."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "george",
                "texto": "Waiting too? This hotel is very slow, isn't it?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  29
                ],
                "opciones": [
                  {
                    "texto": "Yes, it is. But it's beautiful, isn't it?",
                    "ok": true
                  },
                  {
                    "texto": "It's at ten thirty. How far is it?"
                  },
                  {
                    "texto": "Oh no. Has he gone to the doctor?"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "True. I'm here because my house is being painted."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  49
                ],
                "opciones": [
                  {
                    "texto": "So you're here because of your house?",
                    "ok": true
                  },
                  {
                    "texto": "Yes. Do you know where she went?"
                  },
                  {
                    "texto": "Yes. Can you bring us some water?"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Exactly!"
              },
              {
                "quien": "george",
                "texto": "My room is smaller than my house!",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  54
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "But this hotel is nicer than my old one.",
                    "ok": true
                  },
                  {
                    "texto": "If I were you, I would save the money."
                  },
                  {
                    "texto": "Yes. It's on the corner, next to the tree."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "And I slept badly last night.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  38
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "That's bad. Was the bed hard?",
                    "ok": true
                  },
                  {
                    "texto": "Hello? Is this the building manager?"
                  },
                  {
                    "texto": "Sure. Is it a chocolate cake?"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Yes! It was like a rock!",
                "refuerzo": true
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        }
      ],
      "objetos": [
        {
          "id": "reception_bell",
          "svg": "reception_bell",
          "texto_ref": "reception_bell"
        },

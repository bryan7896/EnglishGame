        },
        {
          "id": "lamp",
          "svg": "lamp",
          "texto_ref": "lamp"
        },
        {
          "id": "elevator",
          "svg": "elevator",
          "texto_ref": "elevator",
          "inicia_deshabilitado": true,
          "dialogo": {
            "requiere": "elevator",
            "pasos": [
              {
                "quien": "bryan",
                "reglaIds": [
                  41
                ],
                "opciones": [
                  {
                    "texto": "OK. I'll take my bag to the room.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I still hope the sun comes back."
                  },
                  {
                    "texto": "Wow! Nobody has given me a photo before!"
                  }
                ]
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "habitacion"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "habitacion",
      "titulo": "Room two hundred and five",
      "fondo": "sala_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "emma",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "emma",
                "texto": "Excuse me! I think this is my room!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  29
                ],
                "opciones": [
                  {
                    "texto": "This is room two hundred and five, isn't it?",
                    "ok": true
                  },
                  {
                    "texto": "Here you are. Do I need to wait here?"
                  },
                  {
                    "texto": "Great. What will you be doing in the morning?"
                  }
                ]
              },
              {
                "quien": "emma",
                "texto": "Oh dear, no. I'm in two hundred and six. I came in because the door was open."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  49
                ],
                "opciones": [
                  {
                    "texto": "No problem. It was open because of the cleaning.",
                    "ok": true
                  },
                  {
                    "texto": "Me too. I want to learn to cook pizza."
                  },
                  {
                    "texto": "Look at his face! It must be the dog!"
                  }
                ]
              },
              {
                "quien": "emma",
                "texto": "Your TV is very loud!",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  27
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Sorry! It's too loud. I'll change it.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, I love studying here. It's quiet."
                  },
                  {
                    "texto": "Yes. I still hope it's here somewhere."
                  }
                ]
              },
              {
                "quien": "emma",
                "texto": "Thanks. Well, have a nice stay!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  41
                ],
                "opciones": [
                  {
                    "texto": "You too. I really like this hotel.",
                    "ok": true
                  },
                  {
                    "texto": "I didn't see anybody in the kitchen."
                  },
                  {
                    "texto": "The car stopped, so we got out."
                  }
                ]
              },
              {
                "quien": "emma",
                "texto": "Me too."
              },
              {
                "quien": "emma",
                "texto": "Oh, before I go... where is the elevator from here?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  41
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "It's on the left, near the stairs.",
                    "ok": true
                  },
                  {
                    "texto": "OK. I'll be free by three o'clock."
                  },
                  {
                    "texto": "Yes. One ticket to River Town, please."
                  }
                ]
              },
              {
                "quien": "emma",
                "texto": "Thank you! Oh, I found your umbrella in the hall. Here!",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  50
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "OK, thanks. I'll put it down here.",
                    "ok": true
                  },
                  {
                    "texto": "Not much. Only half of a bottle."
                  },
                  {
                    "texto": "Thanks. I'll give it to him tonight."
                  }
                ]
              },
              {
                "quien": "emma",
                "texto": "Good night!",
                "refuerzo": true
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }
      ],

  "escenas": [
    {
      "id": "sala",
      "titulo": "Planning the trip",
      "fondo": "sala_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "sara",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "george"
          },
          "ocupado": [
            {
              "quien": "sara",
              "texto": "Ask George, Bryan. He travels a lot."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "sara",
                "texto": "Bryan, if you could go anywhere, where would you go?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  4
                ],
                "opciones": [
                  {
                    "texto": "If I had money, I would go to Japan.",
                    "ok": true
                  },
                  {
                    "texto": "Can I help? I don't have anything to do."
                  },
                  {
                    "texto": "We need to cut the onions before cooking them."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Japan! Why?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  54
                ],
                "opciones": [
                  {
                    "texto": "It's the most beautiful country in the world.",
                    "ok": true
                  },
                  {
                    "texto": "Don't worry. I'll bring it from the car."
                  },
                  {
                    "texto": "Yes, I have worked in a team before."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Let's look at the world map. Where is it?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  39
                ],
                "opciones": [
                  {
                    "texto": "Look. Japan is in Asia, near China.",
                    "ok": true
                  },
                  {
                    "texto": "My clothes, my shoes and a towel."
                  },
                  {
                    "texto": "Yes. I'm helping him with his English."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "When does spring start there?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  39
                ],
                "opciones": [
                  {
                    "texto": "In March, I think. On the first day.",
                    "ok": true
                  },
                  {
                    "texto": "Over the last month? Only food and books."
                  },
                  {
                    "texto": "I arrived at ten. Now I'll go home."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Is Japan more expensive than here?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  54
                ],
                "opciones": [
                  {
                    "texto": "Yes, it's more expensive, but it's safer.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. He has taken the bus already."
                  },
                  {
                    "texto": "He has gone home. He was tired."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Why do you love Japan so much?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  49
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Because of the flowers. They're beautiful.",
                    "ok": true
                  },
                  {
                    "texto": "Yes! At five, we'll be dancing!"
                  },
                  {
                    "texto": "I haven't opened it yet. Wait!"
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "What will we be doing this time next year?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  53
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "We'll be walking in Japan!",
                    "ok": true
                  },
                  {
                    "texto": "I know. I'm getting cold, too."
                  },
                  {
                    "texto": "Don't worry. Everybody makes mistakes."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Let's ask George. He travels a lot."
              }
            ]
          }
        },
        {
          "id": "george",
          "rol": "target",
          "antes": {
            "quien": "george",
            "texto": "One moment, my boy."
          },
          "dialogo": {
            "requiere": "sara_hablado",
            "pasos": [
              {
                "quien": "george",
                "texto": "Japan? You should go in spring."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  17
                ],
                "opciones": [
                  {
                    "texto": "Why should we go in spring?",
                    "ok": true
                  },
                  {
                    "texto": "Why did you move to this street?"
                  },
                  {
                    "texto": "That's bad. Was the bed hard?"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Because of the flowers! And their big city is wonderful."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  54
                ],
                "opciones": [
                  {
                    "texto": "Is it the biggest city in the world?",
                    "ok": true
                  },
                  {
                    "texto": "Yes, it is. You like swimming, don't you?"
                  },
                  {
                    "texto": "How long have you lived in this town?"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "One of them! If I were young, I would go with you!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  4
                ],
                "opciones": [
                  {
                    "texto": "If you came with us, it would be fun!",
                    "ok": true
                  },
                  {
                    "texto": "Over the last two weeks, I made the design."
                  },
                  {
                    "texto": "A tea, a sandwich and an orange juice, please."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Have you ever been to Japan?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  28
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No, I've never been there.",
                    "ok": true
                  },
                  {
                    "texto": "For ten minutes, I think."
                  },
                  {
                    "texto": "Yes, and it's really hot today."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "You can look up the hotels on your phone.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  23
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Good idea. I'll look them up tonight.",
                    "ok": true
                  },
                  {
                    "texto": "Great. She lives very near us, then."
                  },
                  {
                    "texto": "The one that you sang last night!"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Good! Have a great trip!"
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "aeropuerto"
              }
            ]
          }
        }
      ],

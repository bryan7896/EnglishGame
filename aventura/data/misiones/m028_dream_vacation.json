{
  "id": "m028",
  "titulo": "Dream vacation",
  "titulo_es": "Las vacaciones soñadas",
  "objetivo": "Plan the vacation of your dreams.",
  "objetivo_es": "Planea las vacaciones de tus sueños.",
  "nivel": "B1",
  "resumen": "Planea con Sara el viaje de tus suenos: elige pais, pide consejos a George y haz el check-in en el aeropuerto.",
  "musica_inicial": "home_loop",
  "reglas_juego": {

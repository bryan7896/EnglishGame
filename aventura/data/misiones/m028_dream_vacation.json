    {
      "id": "aeropuerto",
      "titulo": "The airport",
      "fondo": "aeropuerto",
      "musica": "ride_loop",
      "personajes": [
        {
          "id": "olivia",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "olivia",
                "texto": "Good morning. Where are you flying today?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  39
                ],
                "opciones": [
                  {
                    "texto": "To Japan. Our flight is at ten.",
                    "ok": true
                  },
                  {
                    "texto": "I need help with my suitcase, please."
                  },
                  {
                    "texto": "For twenty minutes, during the first song."
                  }
                ]
              },
              {
                "quien": "olivia",
                "texto": "Can I see your passports, please?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  17
                ],
                "opciones": [
                  {
                    "texto": "Of course. Can we sit together?",
                    "ok": true
                  },
                  {
                    "texto": "I paid online. That's strange, isn't it?"
                  },
                  {
                    "texto": "Are they late because of the storm?"
                  }
                ]
              },
              {
                "quien": "olivia",
                "texto": "Yes. If you wanted a window seat, I would give you one."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  4
                ],
                "opciones": [
                  {
                    "texto": "If it were free, we would take it!",
                    "ok": true
                  },
                  {
                    "texto": "As you know, I always have a plan!"
                  },
                  {
                    "texto": "I'm going to watch the numbers with you!"
                  }
                ]
              },
              {
                "quien": "olivia",
                "texto": "Ha ha, it's free. But you must be at the gate in one hour."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  17
                ],
                "opciones": [
                  {
                    "texto": "OK. We should go now.",
                    "ok": true
                  },
                  {
                    "texto": "Good idea. Buy some for her!"
                  },
                  {
                    "texto": "Half of the bag, I think."
                  }
                ]
              },
              {
                "quien": "olivia",
                "texto": "Have a great trip!"
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }
      ],

                "quien": "bryan",
                "reglaIds": [
                  18
                ],
                "opciones": [
                  {
                    "texto": "Me too. I'm thinking about taking more classes.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, a lot over the last two years."

    {
      "id": "sala",
      "titulo": "The living room",
      "fondo": "sala_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "mom",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "mom",
                "texto": "What's that box, Bryan?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  45,
                  11
                ],
                "opciones": [
                  {
                    "texto": "I don't know. It was brought by Sam.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I have just arrived for my interview."
                  },
                  {
                    "texto": "Hi! I need to order for four people."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Open it! Is there anything inside?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  31
                ],
                "opciones": [
                  {
                    "texto": "There's something soft... and a letter!",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I enjoy reading before sleeping."
                  },
                  {
                    "texto": "Yes. She speaks Spanish and English."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "It's from your grandmother! She sent you a blanket!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  45
                ],
                "opciones": [
                  {
                    "texto": "Wow! Was it made by her?",
                    "ok": true
                  },
                  {
                    "texto": "What exactly did she tell you?"
                  },
                  {
                    "texto": "Not many. How much are they?"
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Yes, she made it with her hands."
              },
              {
                "quien": "mom",
                "texto": "Have you taken the blanket out?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  19
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes, I've taken it out. It's soft!",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I'm helping him with his English."
                  },
                  {
                    "texto": "Yes. I've worked there for two months."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "It's beautiful!",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  11
                ],
                "opciones": [
                  {
                    "texto": "How nice! I'll bring it to my room.",
                    "ok": true
                  },
                  {
                    "texto": "I've worked at a small company since July."
                  },
                  {
                    "texto": "I worked as a waiter for a year."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "And she says: next time, bring some photos when you visit!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  31
                ],
                "opciones": [
                  {
                    "texto": "OK! I don't have any photos, but I'll take some.",
                    "ok": true
                  },
                  {
                    "texto": "Ha ha. And I'll have been drinking coffee all night!"
                  },
                  {
                    "texto": "Yes, I was listening to music when I got on."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Good boy. Now call her and say thank you!"
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }

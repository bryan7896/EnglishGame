  "objetivo": "A strange box came. Find out who sent it.",
  "objetivo_es": "Llegó una caja extraña. Descubre quién la envió.",
  "nivel": "B1",
  "resumen": "Llega una caja extrana con tu nombre. Averigua quien la trajo, quien la envio y que hay adentro.",
  "musica_inicial": "home_loop",

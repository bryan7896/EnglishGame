  "escenas": [
    {
      "id": "casa",
      "titulo": "Your house",
      "fondo": "casa_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "sam",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "sam",
                "texto": "Hello! I have a box for this house. Is anybody home?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  31
                ],
                "opciones": [
                  {
                    "texto": "Yes, I'm here. But nobody ordered anything.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I still hope they say yes."
                  },
                  {
                    "texto": "Yes, please. A window seat is great."
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "Well, your name is on it. It was sent from the city."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  45
                ],
                "opciones": [
                  {
                    "texto": "Who was it sent by?",
                    "ok": true
                  },
                  {
                    "texto": "Did you eat much today?"
                  },
                  {
                    "texto": "Was she seen by the camera?"
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "I don't know. There's no name. I just bring the boxes!"
              },
              {
                "quien": "sam",
                "texto": "Have you opened it yet?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  32
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No, not yet. I've just got it!",
                    "ok": true
                  },
                  {
                    "texto": "Yes, and I slept during the afternoon!"
                  },
                  {
                    "texto": "OK. Let's lie down near the fire."
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "Ha ha. Open it! Maybe it's a gift.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  11
                ],
                "opciones": [
                  {
                    "texto": "Thanks for bringing it!",
                    "ok": true
                  },
                  {
                    "texto": "Wow! For forty years!"
                  },
                  {
                    "texto": "For ten minutes, I think."
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "You're welcome! Have a nice day."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "sala"
              }
            ]
          }
        },
        {
          "id": "linda",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "linda",
              "texto": "I hope it's something nice!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "linda",
                "texto": "Did you get a box too? I got one yesterday!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  45
                ],
                "opciones": [
                  {
                    "texto": "Really? Was it brought by Sam?",
                    "ok": true
                  },
                  {
                    "texto": "Had she already taken the train?"
                  },
                  {
                    "texto": "Thanks! Is it a long walk?"
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Yes! It was a gift from my sister."
              },
              {
                "quien": "linda",
                "texto": "She gave me a lamp. Look!",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  25
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Nice! What did you give her?",
                    "ok": true
                  },
                  {
                    "texto": "Hello? Is this the building manager?"
                  },
                  {
                    "texto": "Of course. Can we sit together?"
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Ha ha. Nothing yet!",
                "refuerzo": true
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        }
      ],
      "objetos": [

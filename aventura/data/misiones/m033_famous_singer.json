  "escenas": [
    {
      "id": "calle",
      "titulo": "Outside the concert",
      "fondo": "calle_noche",
      "musica": "street_loop",
      "personajes": [
        {
          "id": "max",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "hank"
          },
          "ocupado": [
            {
              "quien": "max",
              "texto": "Talk to the guard, Bryan!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "max",
                "texto": "Bryan, Nina is in there! The singer who sang Night Rain!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  5
                ],
                "opciones": [
                  {
                    "texto": "Really? Nina, who is my favorite singer, is here?",
                    "ok": true
                  },
                  {
                    "texto": "My card is in your machine. How can I get it back?"
                  },
                  {
                    "texto": "Yes. Have you found other people for this job?"
                  }
                ]
              },
              {
                "quien": "max",
                "texto": "But we don't have tickets. The guard won't let us in."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  9
                ],
                "opciones": [
                  {
                    "texto": "As you know, I always have a plan!",
                    "ok": true
                  },
                  {
                    "texto": "I've checked the mail every day over the last week."
                  },
                  {
                    "texto": "Thank you! I've waited for this day for a long time."
                  }
                ]
              },
              {
                "quien": "max",
                "texto": "Ha ha. OK, talk to Hank."
              }
            ]
          }
        },
        {
          "id": "hank",
          "rol": "target",
          "antes": {
            "quien": "hank",
            "texto": "One moment, please."
          },
          "dialogo": {
            "requiere": "max_hablado",
            "pasos": [
              {
                "quien": "hank",
                "texto": "Sorry. No ticket, no concert."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  25
                ],
                "opciones": [
                  {
                    "texto": "Please! Can you give us one minute?",
                    "ok": true
                  },
                  {
                    "texto": "OK. Is the park on Main Street?"
                  },
                  {
                    "texto": "So you're here because of your house?"
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Hmm. Why do you want to see her?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  9
                ],
                "opciones": [
                  {
                    "texto": "I see her as the best singer in the world.",
                    "ok": true
                  },
                  {
                    "texto": "By Friday, I'll have been working on it for a month."
                  },
                  {
                    "texto": "Only half of it? I'll go to the pharmacy now."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "OK, OK. A man gave me these two tickets. Take them!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  25
                ],
                "opciones": [
                  {
                    "texto": "Thank you! You've given us a great night!",
                    "ok": true
                  },
                  {
                    "texto": "I had been working all week before this!"
                  },
                  {
                    "texto": "I lost my phone at the bus stop."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Enjoy the show!"
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "concierto"
              }
            ]
          }
        }
      ],

    {
      "id": "concierto",
      "titulo": "The concert",
      "fondo": "concierto_noche",
      "musica": "party_loop",
      "personajes": [
        {
          "id": "nina",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "nina",
                "texto": "Hello! Are you the boys who got the last tickets?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  5
                ],
                "opciones": [
                  {
                    "texto": "Yes! The man who works at the door helped us.",
                    "ok": true
                  },
                  {
                    "texto": "No. All the bags have gone, and mine isn't here."
                  },
                  {
                    "texto": "By summer, you'll have been reading it a long time!"
                  }
                ]
              },
              {
                "quien": "nina",
                "texto": "Ha ha, Hank! Which song do you like?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  5
                ],
                "opciones": [
                  {
                    "texto": "The one that you sang last night!",
                    "ok": true
                  },
                  {
                    "texto": "Over the holidays, I'll visit my uncle."
                  },
                  {
                    "texto": "Yes. It's the best beach I know."
                  }
                ]
              },
              {
                "quien": "nina",
                "texto": "Here, I want to give you something. A photo!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  25
                ],
                "opciones": [
                  {
                    "texto": "Wow! Nobody has given me a photo before!",
                    "ok": true
                  },
                  {
                    "texto": "Perfect. By three, we will all be ready."
                  },
                  {
                    "texto": "So he had found it, not taken it!"
                  }
                ]
              },
              {
                "quien": "nina",
                "texto": "Have you ever met a singer before?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  28
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No, I've never met one before!",
                    "ok": true
                  },
                  {
                    "texto": "I had been looking for wood."
                  },
                  {
                    "texto": "Because you're sick? Stay in bed."
                  }
                ]
              },
              {
                "quien": "nina",
                "texto": "Ha ha. Come again, as my friends!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  9
                ],
                "opciones": [
                  {
                    "texto": "We will! As soon as you have another concert!",
                    "ok": true
                  },
                  {
                    "texto": "I'm OK. I had run all the way here."
                  },
                  {
                    "texto": "I was making the fire when I heard it."
                  }
                ]
              },
              {
                "quien": "nina",
                "texto": "And what do you do?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  9
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I work as an engineer.",
                    "ok": true
                  },
                  {
                    "texto": "Let's look for it together."
                  },
                  {
                    "texto": "Let's call the building manager."
                  }
                ]
              },
              {
                "quien": "nina",
                "texto": "Cool! See you soon!"
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }

                "texto": "Um... Bryan, I need to talk to an old person for my school project."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  34
                ],
                "opciones": [
                  {
                    "texto": "Talk to Walter. He has lived here for seventy years.",
                    "ok": true
                  },
                  {
                    "texto": "I don't know yet. I still hope it's a yes!"
                  },
                  {
                    "texto": "My card. I will show you my name on it."
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "Have you ever talked to Walter?",
                "refuerzo": true

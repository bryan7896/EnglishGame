                  {
                    "texto": "No. Have you seen a girl with a red jacket?"
                  },
                  {
                    "texto": "The elevator is broken. Can it be repaired today?"
                  }
                ]
              },
              {
                "quien": "walter",
                "texto": "Ha ha. Come back soon, children."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  1
                ],
                "opciones": [
                  {
                    "texto": "We will. We had been looking for someone like you!",
                    "ok": true

              {
                "quien": "bryan",
                "reglaIds": [
                  40
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Wow! For forty years!",
                    "ok": true
                  },
                  {
                    "texto": "I still hope so!"
                  },
                  {
                    "texto": "Yes, I brought it inside."
                  }
                ]
              },
              {
                "quien": "walter",
                "texto": "Yes. And next month, my wife and I will be married for fifty years!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  44
                ],
                "opciones": [
                  {
                    "texto": "Wow! By then, you'll have been living together for fifty years!",
                    "ok": true
                  },
                  {
                    "texto": "I'm going to the bus stop, then home."
                  },
                  {
                    "texto": "Yes! If I hurry, I'll find her there."

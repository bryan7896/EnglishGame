              },
              {
                "quien": "walter",
                "texto": "Look at this photo album. This is me at twenty."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  1
                ],
                "opciones": [
                  {
                    "texto": "You look tired. Had you been working all day?",
                    "ok": true
                  },
                  {
                    "texto": "Yes. Did you see the person who took it?"
                  },
                  {
                    "texto": "Is it the lamp that was in your house?"
                  }
                ]
              },
              {
                "quien": "walter",
                "texto": "Yes! I had been building houses since six in the morning."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  34
                ],
                "opciones": [
                  {
                    "texto": "Wow. For twelve hours?",
                    "ok": true
                  },
                  {
                    "texto": "I still hope so!"
                  },
                  {
                    "texto": "But you still hope, right?"
                  }
                ]
              },
              {
                "quien": "walter",
                "texto": "Yes! I worked like that for forty years.",
                "refuerzo": true

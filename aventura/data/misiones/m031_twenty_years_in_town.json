                  {
                    "texto": "If I had more money, I would go to the beach."
                  },
                  {
                    "texto": "If I had a million, I would travel."
                  }
                ]
              },
              {
                "quien": "walter",
                "texto": "My house was here in nineteen fifty. And it's still here!",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  13
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "It's here now, and it will be here tomorrow!",
                    "ok": true
                  },
                  {
                    "texto": "No problem. It was open because of the cleaning."
                  },
                  {
                    "texto": "I see her as the best singer in the world."
                  }
                ]
              },
              {
                "quien": "walter",
                "texto": "Ha ha, yes. Come to my house. I'll show you some photos."
              }

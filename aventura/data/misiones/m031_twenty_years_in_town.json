            "pasos": [
              {
                "quien": "walter",
                "texto": "Hello, young people. Can I help you?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  34
                ],
                "opciones": [
                  {
                    "texto": "How long have you lived in this town?",
                    "ok": true
                  },
                  {
                    "texto": "Yes, please. Can you make a big coffee?"
                  },
                  {
                    "texto": "OK. Is this the paper for the new card?"
                  }
                ]
              },
              {
                "quien": "walter",
                "texto": "Since nineteen fifty. Before that, I had been living in the mountains."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  1
                ],
                "opciones": [
                  {
                    "texto": "Really? What had you been doing there?",
                    "ok": true
                  },
                  {
                    "texto": "Thank you. What does the book look like?"
                  },
                  {
                    "texto": "Sure. Do I need to sign here too?"
                  }
                ]
              },
              {
                "quien": "walter",
                "texto": "I had been working with my father. Next year, I'll have been living in this town for seventy-five years!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  44
                ],
                "opciones": [
                  {
                    "texto": "Wow! By then, you'll have been living here a long time.",
                    "ok": true

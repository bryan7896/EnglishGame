  },
  "escenas": [
    {
      "id": "cuarto",
      "titulo": "Jake's room",
      "fondo": "sala_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "jake",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "jake",
                "texto": "Bryan... I feel terrible. I think I'm getting sick."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  30
                ],
                "opciones": [
                  {
                    "texto": "Oh no! When did you get sick?",
                    "ok": true
                  },
                  {
                    "texto": "OK. Do I need to bring it back soon?"
                  },
                  {
                    "texto": "No, I have never waited this long."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Last night. And now I'm getting worse."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  37
                ],
                "opciones": [
                  {
                    "texto": "Did you eat much today?",
                    "ok": true
                  },
                  {
                    "texto": "I need it by Friday."
                  },
                  {
                    "texto": "Yes, I've moved two times."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "No, only half of a sandwich. And I have no medicine."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  47
                ],
                "opciones": [
                  {
                    "texto": "Only half of it? I'll go to the pharmacy now.",
                    "ok": true
                  },
                  {
                    "texto": "I know. It's too hot to lie in the sun."
                  },
                  {
                    "texto": "Ha ha! She wants a bigger garden, not a house!"
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "I didn't go to work today.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  49
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Because you're sick? Stay in bed.",
                    "ok": true
                  },
                  {
                    "texto": "OK. I'll take them off now."
                  },
                  {
                    "texto": "We're going to the library together."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Can you make me some soup later?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  14
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Sure. I'll make you some soup.",
                    "ok": true
                  },
                  {
                    "texto": "On Main Street, near the park."
                  },
                  {
                    "texto": "It will be ready by four."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Thanks, man. You're a good friend."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "farmacia"
              }
            ]
          }
        }
      ],
      "objetos": [
        {
          "id": "bed",
          "svg": "bed",
          "texto_ref": "bed"
        },
        {
          "id": "blanket",
          "svg": "blanket",
          "texto_ref": "blanket"
        },
        {
          "id": "thermometer",
          "svg": "thermometer"
        },
        {
          "id": "water",
          "svg": "bottle",
          "texto_ref": "bottle"
        },
        {
          "id": "window",
          "svg": "window",
          "texto_ref": "window"
        }
      ]
    },
    {
      "id": "farmacia",
      "titulo": "The pharmacy",
      "fondo": "farmacia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "lily",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "lily",
              "texto": "Um... I hope Jake gets better."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "lily",
                "texto": "Um... Bryan? What are you doing here?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  30
                ],
                "opciones": [
                  {
                    "texto": "My friend Jake got sick last night.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, I've talked to him many times."
                  },
                  {
                    "texto": "No. I had only sent one letter."
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "Oh no. Half of my class is sick, too."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  47
                ],
                "opciones": [
                  {
                    "texto": "Wow, half of them? That's a lot!",
                    "ok": true
                  },
                  {
                    "texto": "She has gone to the station, maybe."
                  },
                  {
                    "texto": "I don't know. Somebody has taken them."
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "Does Jake live alone?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  20
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. He lives near the park.",
                    "ok": true
                  },
                  {
                    "texto": "Don't worry. We'll finish by nine."
                  },
                  {
                    "texto": "Yes. And it's very cold today."
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "I see. Tell Jake to get well soon."
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        },
        {
          "id": "patel",
          "rol": "target",
          "dialogo": {
            "pasos": [
              {
                "quien": "patel",
                "texto": "Good afternoon. What can I do for you?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  30
                ],
                "opciones": [
                  {
                    "texto": "My friend got sick. He feels very hot.",
                    "ok": true
                  },
                  {
                    "texto": "Wow. I listen to music while I work."
                  },
                  {
                    "texto": "Let's do the kitchen, then make the bed."
                  }
                ]
              },
              {
                "quien": "patel",
                "texto": "I see. Does he have a headache?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  37
                ],
                "opciones": [
                  {
                    "texto": "A little. And he can't eat much food.",
                    "ok": true
                  },
                  {
                    "texto": "Ha ha. It can't be older than you!"
                  },
                  {
                    "texto": "I lost my phone at the bus stop."
                  }
                ]
              },
              {
                "quien": "patel",
                "texto": "OK. Take this medicine. He needs half of a spoon, two times a day."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  47
                ],
                "opciones": [
                  {
                    "texto": "Half of a spoon, two times a day. OK.",
                    "ok": true
                  },
                  {
                    "texto": "Good idea! Over the holidays, we'll have more time."
                  },
                  {
                    "texto": "I will. I had never lost my wallet before!"
                  }
                ]
              },
              {
                "quien": "patel",
                "texto": "And he should drink a lot of water."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  37
                ],
                "opciones": [
                  {
                    "texto": "How many bottles of water does he need?",
                    "ok": true
                  },
                  {
                    "texto": "Has it gone? When does the next one come?"
                  },
                  {
                    "texto": "That's OK. Have you worked here for a long time?"
                  }
                ]
              },
              {
                "quien": "patel",
                "texto": "A few bottles every day. He will get better soon."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  30
                ],
                "opciones": [
                  {
                    "texto": "Great. I hope he gets better quickly.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, I'm here. But nobody ordered anything."
                  },
                  {
                    "texto": "Great. She lives very near us, then."
                  }
                ]
              },
              {
                "quien": "patel",
                "texto": "So the medicine isn't for you, right?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  8
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No, it's for him. He's at home.",
                    "ok": true
                  },
                  {
                    "texto": "Don't worry. Put the lights on first."
                  },
                  {
                    "texto": "Yes. I want to learn more English."
                  }
                ]
              },
              {
                "quien": "patel",
                "texto": "Please give this paper to your friend.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  25
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Thanks. I'll give it to him tonight.",
                    "ok": true
                  },
                  {
                    "texto": "To Japan. Our flight is at ten."
                  },
                  {
                    "texto": "Because I forgot my umbrella this morning."
                  }
                ]
              },
              {
                "quien": "patel",
                "texto": "He must take it after he eats. Do you understand?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  42
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. After breakfast, lunch and dinner.",
                    "ok": true
                  },
                  {
                    "texto": "I don't know where she went."
                  },
                  {
                    "texto": "No, I've never stayed here before."
                  }
                ]
              },
              {
                "quien": "patel",
                "texto": "That's eight dollars, please."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "casa"
              }
            ]
          }
        }
      ],
      "objetos": [
        {
          "id": "medicine",
          "svg": "medicine",
          "texto_ref": "medicine"
        },
        {
          "id": "cash_register",
          "svg": "cash_register",
          "texto_ref": "cash_register"
        },
        {
          "id": "water",
          "svg": "bottle",
          "texto_ref": "bottle"
        }
      ]
    },
    {
      "id": "casa",
      "titulo": "Back with Jake",
      "fondo": "sala_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "jake",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "jake",
                "texto": "You're back! Did you get the medicine?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  47
                ],
                "opciones": [
                  {
                    "texto": "Yes. Take half of this spoon now.",
                    "ok": true
                  },
                  {
                    "texto": "Only for three hours, during the morning."
                  },
                  {
                    "texto": "Let's make a list of the problems."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Thanks. I'm getting tired. I want to sleep."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  30
                ],
                "opciones": [
                  {
                    "texto": "Sleep well. You'll get better tomorrow.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. It was taken this morning."
                  },
                  {
                    "texto": "No, it stopped. It's sunny now."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "You're a good friend, Bryan."
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }
      ],
      "objetos": [

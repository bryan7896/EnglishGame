{
  "id": "m010",
  "titulo": "The sick day",
  "titulo_es": "El día de enfermo",
  "objetivo": "Your friend is sick. Get what he needs at the pharmacy.",
  "objetivo_es": "Tu amigo está enfermo. Consigue lo que necesita en la farmacia.",
  "nivel": "A2",
  "resumen": "Jake esta enfermo. Averigua como se siente, ve a la farmacia por su medicina y llevasela.",
  "musica_inicial": "home_loop",
  "reglas_juego": {
    "modal_reintento": {
      "color": "naranja",
      "opciones": 2
    },
    "tercer_error": "revelar_correcta_sin_puntos_y_a_repaso",
    "texto_en_tercera_pulsacion": {
      "puntos": 0.5
    },

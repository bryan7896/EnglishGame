  "escenas": [
    {
      "id": "casa",
      "titulo": "Your house",
      "fondo": "casa_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "linda",
          "rol": "anfitrion",
          "auto": true,
          "pista": {
            "marca": "mailbox"
          },
          "ocupado": [
            {
              "quien": "linda",
              "texto": "Good luck, Bryan!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "linda",
                "texto": "Good morning, Bryan! Are you waiting for the mail?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  32
                ],
                "opciones": [
                  {
                    "texto": "Yes. Has the mail arrived yet?",
                    "ok": true
                  },
                  {
                    "texto": "Great. Are you going to dance, too?"
                  },
                  {
                    "texto": "Maybe it's in your car park."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Not yet. Are you waiting for something special?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  26
                ],
                "opciones": [
                  {
                    "texto": "A letter from the university. I still hope it comes today.",
                    "ok": true
                  },
                  {
                    "texto": "Ha ha! She wants a bigger garden, not a house!"
                  },
                  {
                    "texto": "Wow! By then, you'll have been living together for fifty years!"
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "How long have you waited?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  52
                ],
                "opciones": [
                  {
                    "texto": "I've checked the mail every day over the last week.",
                    "ok": true
                  },
                  {
                    "texto": "Oh no! I had missed the bus, so I walked."
                  },
                  {
                    "texto": "Excuse me. I left my phone on a bus seat."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "When did you send your papers?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  13
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I sent them in May. Now I'm waiting.",
                    "ok": true
                  },
                  {
                    "texto": "Half of it? Then she will be sad!"
                  },
                  {
                    "texto": "My friend got sick. He feels very hot."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "When will they answer?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "They'll answer by the end of the month.",
                    "ok": true
                  },
                  {
                    "texto": "It's a black phone with an orange case."
                  },
                  {
                    "texto": "Let's walk across the bridge to the station."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Look! The mail is here!"
              }
            ],
            "al_terminar": [
              {
                "habilita": "mailbox"
              }
            ]
          }
        }
      ],
      "objetos": [

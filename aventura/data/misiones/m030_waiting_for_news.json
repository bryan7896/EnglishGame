    {
      "id": "sala",
      "titulo": "The letter",
      "fondo": "sala_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "mom",
          "rol": "anfitrion",
          "auto": true,
          "pista": {
            "marca": "sara"
          },
          "ocupado": [
            {
              "quien": "mom",
              "texto": "Talk to Sara, Bryan!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "mom",
                "texto": "Bryan, did you bring the letter inside?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  11
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes, I brought it inside.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. He has left his old apartment."
                  },
                  {
                    "texto": "I think he works every day."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Is that the letter? Open it!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  52
                ],
                "opciones": [
                  {
                    "texto": "I've waited for it over the last two months!",
                    "ok": true
                  },
                  {
                    "texto": "In March, I think. On the first day."
                  },
                  {
                    "texto": "We're going to the university. We took the wrong bus."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Do you still hope for good news?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  26
                ],
                "opciones": [
                  {
                    "texto": "Yes. I still hope they say yes.",
                    "ok": true
                  },
                  {
                    "texto": "I'll be helping you with the cake."
                  },
                  {
                    "texto": "It's very cold, but you can swim."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Had you sent any other letters before?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  43
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No. I had only sent one letter.",
                    "ok": true
                  },
                  {
                    "texto": "Because I have a job interview tomorrow."
                  },
                  {
                    "texto": "Sorry! I'm in a hurry for my train."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "So, what does it say?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  32
                ],
                "opciones": [
                  {
                    "texto": "I haven't opened it yet. Wait!",
                    "ok": true
                  },
                  {
                    "texto": "OK. I'll take it off now."
                  },
                  {
                    "texto": "OK. I'll take the cheaper bananas."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Look, Sara is here!"
              }
            ]
          }
        },
        {
          "id": "sara",
          "rol": "target",
          "antes": {
            "quien": "sara",
            "texto": "Hi! One moment."
          },
          "dialogo": {
            "requiere": "mom_hablado",
            "pasos": [
              {
                "quien": "sara",
                "texto": "Bryan! What does the letter say?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  26
                ],
                "opciones": [
                  {
                    "texto": "I don't know yet. I still hope it's a yes!",
                    "ok": true
                  },
                  {
                    "texto": "If I won, I would buy you a new house."
                  },
                  {
                    "texto": "We will. We had been looking for someone like you!"
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Open it! We can talk about it over coffee."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  52
                ],
                "opciones": [
                  {
                    "texto": "OK... Yes! I got in! Let's talk over dinner!",
                    "ok": true
                  },
                  {
                    "texto": "Yes. A man took it and left five minutes ago."
                  },
                  {
                    "texto": "We will! As soon as you have another concert!"
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Wonderful! I knew it!"
              },
              {
                "quien": "sara",
                "texto": "Have you told your dad yet?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  10
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No, I haven't called him yet.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I'm looking for the bread."
                  },
                  {
                    "texto": "No, I've never stayed here before."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Call him now! He'll be so happy!",
                "refuerzo": true
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }
      ],

        {
          "id": "mailbox",
          "svg": "mailbox",
          "texto_ref": "mailbox",
          "inicia_deshabilitado": true,
          "dialogo": {
            "requiere": "mailbox",
            "pasos": [
              {
                "quien": "bryan",
                "reglaIds": [
                  32
                ],
                "opciones": [
                  {
                    "texto": "Oh! The letter has just arrived!",
                    "ok": true
                  },
                  {
                    "texto": "Oh no! I cooked it badly."
                  },
                  {
                    "texto": "Good idea. I'll tell them everything."
                  }
                ]

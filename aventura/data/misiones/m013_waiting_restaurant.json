            "pasos": [
              {
                "quien": "leo",
                "texto": "Here is your food. Enjoy!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  32
                ],
                "opciones": [
                  {
                    "texto": "Thank you! Sara has already started eating!",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I'm helping him with his English."
                  },
                  {
                    "texto": "He has gone home. He was tired."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "This is the best pasta I have ever eaten."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  10
                ],
                "opciones": [
                  {
                    "texto": "And this is the best steak I've ever had!",
                    "ok": true
                  },
                  {
                    "texto": "Yes, but I played badly. It was very wet."
                  },
                  {
                    "texto": "That's the woman who was wearing the red hat!"
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "It was worth the wait!"
              }
            ],

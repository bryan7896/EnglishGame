  "escenas": [
    {
      "id": "restaurante",
      "titulo": "The restaurant",
      "fondo": "restaurante_noche",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "sara",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "leo"
          },
          "ocupado": [
            {
              "quien": "sara",
              "texto": "Talk to the waiter, Bryan. I'm so hungry!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "sara",
                "texto": "Bryan, we ordered forty minutes ago. Has the food arrived yet?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  32
                ],
                "opciones": [
                  {
                    "texto": "No, it hasn't arrived yet.",
                    "ok": true
                  },
                  {
                    "texto": "Don't worry. Everybody makes mistakes."
                  },
                  {
                    "texto": "I'm interested in learning new things."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Look! That table has their food, and they came after us!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  32,
                  10
                ],
                "opciones": [
                  {
                    "texto": "I know. They have just arrived!",
                    "ok": true
                  },
                  {
                    "texto": "Give me half of it, please!"
                  },
                  {
                    "texto": "Cool! My uncle works there, too."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Have you ever waited this long in a restaurant?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  28
                ],
                "opciones": [
                  {
                    "texto": "No, I have never waited this long.",
                    "ok": true
                  },
                  {
                    "texto": "I'll be helping you with the cake."
                  },
                  {
                    "texto": "Yes. Take half of this spoon now."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "How long have we been here?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  40
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "For forty minutes!",
                    "ok": true
                  },
                  {
                    "texto": "Just a little sugar, please."
                  },
                  {
                    "texto": "Yes. Here's my train ticket."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Please, talk to the waiter."
              }
            ]
          }
        },
        {
          "id": "leo",
          "rol": "target",
          "antes": {
            "quien": "leo",
            "texto": "One moment, please."
          },
          "pista": {
            "marca": "marco"
          },
          "dialogo": {
            "requiere": "sara_hablado",
            "pasos": [
              {
                "quien": "leo",
                "texto": "Good evening. Is everything OK?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  10
                ],
                "opciones": [
                  {
                    "texto": "Not really. We have waited for forty minutes.",
                    "ok": true
                  },
                  {
                    "texto": "I'm going to visit my grandmother on Saturday."
                  },
                  {
                    "texto": "I'm going to watch the numbers with you!"
                  }
                ]
              },
              {
                "quien": "leo",
                "texto": "Why are you looking at the other table?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  49
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Because they got their food before us.",
                    "ok": true
                  },
                  {
                    "texto": "We live at number ten, Main Street."
                  },
                  {
                    "texto": "Great. I hope he gets better quickly."
                  }
                ]
              },
              {
                "quien": "leo",
                "texto": "Can I get you anything while you wait?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  11
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. Can you bring us some water?",
                    "ok": true
                  },
                  {
                    "texto": "Over the holidays, I visited my friends."
                  },
                  {
                    "texto": "I'll give you a new one tomorrow."
                  }
                ]
              },
              {
                "quien": "leo",
                "texto": "Of course. I'm very sorry. Let me check... The chef has just finished your pasta!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  32
                ],
                "opciones": [
                  {
                    "texto": "Great! And the steak? Is it ready yet?",
                    "ok": true
                  },
                  {
                    "texto": "In March, I think. On the first day."
                  },
                  {
                    "texto": "Great! It's going to be a perfect day!"
                  }
                ]
              },
              {
                "quien": "leo",
                "texto": "Almost. Have you ever tried our chocolate cake? It's free tonight."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  28
                ],
                "opciones": [
                  {
                    "texto": "No, I've never tried it. Is it good?",
                    "ok": true
                  },
                  {
                    "texto": "OK. Do I need to come back here?"
                  },
                  {
                    "texto": "He has gone to the park, I think."
                  }
                ]
              },
              {
                "quien": "leo",
                "texto": "It's the best in town! The chef wants to say sorry, too."
              },
              {
                "quien": "leo",
                "texto": "Look, that man in the white hat is our chef.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  5
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Is he the chef who made our pasta?",
                    "ok": true
                  },
                  {
                    "texto": "OK. Have you seen anybody near the kitchen?"
                  },
                  {
                    "texto": "Is it the biggest city in the world?"
                  }
                ]
              },
              {
                "quien": "leo",
                "texto": "Yes, that's Marco. Here he comes!",
                "refuerzo": true
              }
            ]
          }
        },
        {
          "id": "marco",
          "rol": "target",
          "antes": {
            "quien": "marco",
            "texto": "Sorry, the kitchen is very busy!"
          },
          "dialogo": {
            "requiere": "leo_hablado",
            "pasos": [
              {
                "quien": "marco",
                "texto": "Hello, my friend! I'm the chef. I'm so sorry about the wait."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  28
                ],
                "opciones": [
                  {
                    "texto": "That's OK. Have you worked here for a long time?",
                    "ok": true
                  },
                  {
                    "texto": "Mine is dead too. We have to find a taxi."
                  },
                  {
                    "texto": "We will. We had been looking for someone like you!"
                  }
                ]
              },
              {
                "quien": "marco",
                "texto": "Yes, for ten years. But tonight a cook has gone home sick."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  10
                ],
                "opciones": [
                  {
                    "texto": "Oh no. Has he gone to the doctor?",
                    "ok": true
                  },
                  {
                    "texto": "Great! I'll bring the bread while you serve."
                  },
                  {
                    "texto": "I didn't bring it because it was sunny."
                  }
                ]
              },
              {
                "quien": "marco",
                "texto": "Yes. But don't worry, your steak is ready now!"
              },
              {
                "quien": "marco",
                "texto": "Have you eaten here before?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  19
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No. I've never eaten here before.",
                    "ok": true
                  },
                  {
                    "texto": "Maybe it's in your car park."
                  },
                  {
                    "texto": "I had been looking for wood."
                  }
                ]
              },
              {
                "quien": "marco",
                "texto": "Then I hope you come back again!",
                "refuerzo": true
              }
            ],
            "al_terminar": [
              {
                "habilita": "table"
              }
            ]
          }
        }

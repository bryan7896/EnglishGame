  "escenas": [
    {
      "id": "calle",
      "titulo": "The city",
      "fondo": "ciudad_dia",
      "musica": "street_loop",
      "personajes": [
        {
          "id": "jake",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "jake",
                "texto": "Bryan! Sara called me. She's lost in the city, and her phone has no battery!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  43
                ],
                "opciones": [
                  {
                    "texto": "Lost? Where had she gone before she called?",
                    "ok": true
                  },
                  {
                    "texto": "I'm a student. And where do you work?"
                  },
                  {
                    "texto": "OK. Do I need to come back here?"
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "She had been at the coffee shop. Then she took a walk."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  12
                ],
                "opciones": [
                  {
                    "texto": "If we go to the coffee shop, Mia will know.",
                    "ok": true
                  },
                  {
                    "texto": "OK! I don't have any photos, but I'll take some."
                  },
                  {
                    "texto": "Ha ha! She wants a bigger garden, not a house!"
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Good idea! What would you do if you were lost?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  4
                ],
                "opciones": [
                  {
                    "texto": "If I were lost, I would ask somebody.",
                    "ok": true
                  },
                  {
                    "texto": "He's worried because he thinks he speaks badly."
                  },
                  {
                    "texto": "Yes, but there are too many people today."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Do you still hope to find her before dark?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  26
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes! I still hope she's OK.",
                    "ok": true
                  },
                  {
                    "texto": "No. Nothing else has been taken."
                  },
                  {
                    "texto": "Sleep well. You'll get better tomorrow."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Then go! I'll look in the park."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "cafe"
              }
            ]
          }
        }
      ],

    {
      "id": "casa",
      "titulo": "Home",
      "fondo": "casa_noche",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "sara",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "sara",
                "texto": "Bryan! You found me! My phone had no battery, and I got lost."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  43
                ],
                "opciones": [
                  {
                    "texto": "We were worried! Where had you been all day?",
                    "ok": true
                  },
                  {
                    "texto": "Is it the lamp that was in your house?"
                  },
                  {
                    "texto": "Yes. Did you see the person who took it?"
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "I had walked all over the city. I don't know these streets."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  4
                ],
                "opciones": [
                  {
                    "texto": "If you lived here, you would know every street!",
                    "ok": true
                  },
                  {
                    "texto": "Can you give them to me? I can check."
                  },
                  {
                    "texto": "No problem. It was open because of the cleaning."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Sara! Come in. It's cold, and dinner is ready."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  41
                ],
                "opciones": [
                  {
                    "texto": "Come in, Sara. We can eat together.",
                    "ok": true
                  },
                  {
                    "texto": "Great. I hope he gets better quickly."
                  },
                  {
                    "texto": "Yes, I'm here. But nobody ordered anything."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Thank you, Bryan. You're a real friend."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  12
                ],
                "opciones": [
                  {
                    "texto": "If you get lost again, I'll find you again!",
                    "ok": true
                  },
                  {
                    "texto": "Yes. It was used this morning, then it stopped."
                  },
                  {
                    "texto": "But this hotel is nicer than my old one."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Today I was lost, and you found me. And tomorrow?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  13
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Tomorrow, I'll show you the city!",
                    "ok": true
                  },
                  {
                    "texto": "Don't worry. We'll do our best."
                  },
                  {
                    "texto": "Oh no! I cooked it badly."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Ha ha. Deal!"
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }

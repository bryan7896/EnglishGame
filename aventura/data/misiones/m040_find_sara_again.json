    {
      "id": "cafe",
      "titulo": "The coffee shop",
      "fondo": "cafe_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "mia",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "mia",
                "texto": "Bryan! Are you looking for Sara? She was here an hour ago."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  41
                ],
                "opciones": [
                  {
                    "texto": "Yes. Do you know where she went?",
                    "ok": true
                  },
                  {
                    "texto": "Can you call a taxi for us?"
                  },
                  {
                    "texto": "Why did you move to this street?"
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "She said she wanted to see the trains."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  4
                ],
                "opciones": [
                  {
                    "texto": "If I were her, I would go to the station.",
                    "ok": true
                  },
                  {
                    "texto": "By next month, I'll have been working here a year."
                  },
                  {
                    "texto": "OK. I'll take it off and put it down here."
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "Good idea. She left an hour ago.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  15
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "She has gone to the station, maybe.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I told them dinner was ready."
                  },
                  {
                    "texto": "Half of a million? She'll be happy!"
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "Hurry! The station is near."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "estacion"
              }
            ]
          }
        }
      ],
      "objetos": [

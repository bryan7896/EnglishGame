    {
      "id": "estacion",
      "titulo": "The train station",
      "fondo": "estacion_tren",
      "musica": "ride_loop",
      "personajes": [
        {
          "id": "sam",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "sam",
                "texto": "Hello again, Bryan! Are you taking a train?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  41
                ],
                "opciones": [
                  {
                    "texto": "No. Have you seen a girl with a red jacket?",
                    "ok": true
                  },
                  {
                    "texto": "Bananas. Can you look for some good bananas?"
                  },
                  {
                    "texto": "That's OK. Have you worked here for a long time?"
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "Yes! She had bought a ticket, but then she left."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  43
                ],
                "opciones": [
                  {
                    "texto": "Had she already taken the train?",
                    "ok": true
                  },
                  {
                    "texto": "How can we get to the university?"
                  },
                  {
                    "texto": "Great! Can it be checked every month?"
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "No. She said she was going home. She lives near your house, right?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  12
                ],
                "opciones": [
                  {
                    "texto": "Yes! If I hurry, I'll find her there.",
                    "ok": true
                  },
                  {
                    "texto": "Thanks! The market looks like a big party!"
                  },
                  {
                    "texto": "Good idea. And we can finish by midnight."
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "What will you be doing tonight?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  53
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I'll be having dinner with Sara and my mom.",
                    "ok": true
                  },
                  {
                    "texto": "I will. I don't want to get wet again."
                  },
                  {
                    "texto": "Can I help? I don't have anything to do."
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "Take a taxi! It's faster."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "casa"
              }
            ]
          }
        }

{
  "id": "m040",
  "titulo": "Find Sara again",
  "titulo_es": "Encuentra a Sara otra vez",
  "objetivo": "Sara is lost in the city. Use everything you learned to find her.",
  "objetivo_es": "Sara se perdió en la ciudad. Usa todo lo que aprendiste para encontrarla.",
  "nivel": "B1",
  "resumen": "Mision final: Sara se perdio en la ciudad sin bateria. Sigue su pista por la cafeteria y la estacion hasta encontrarla.",
  "musica_inicial": "street_loop",

  "escenas": [
    {
      "id": "sala",
      "titulo": "Your living room",
      "fondo": "sala_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "tom",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "bella"
          },
          "ocupado": [
            {
              "quien": "tom",
              "texto": "Go and talk to Bella, Bryan!"
            },
            {
              "quien": "tom",
              "texto": "This is going to be great!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "tom",
                "texto": "Bryan, Sara's birthday is on Saturday. Let's plan a surprise party!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  36
                ],
                "opciones": [
                  {
                    "texto": "Great idea! I'm going to call everybody.",
                    "ok": true
                  },
                  {
                    "texto": "My clothes, my shoes and a towel."
                  },
                  {
                    "texto": "The money machine outside took my card."
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "Everything must be ready before Saturday.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Don't worry. By Friday, everything will be ready.",
                    "ok": true
                  },
                  {
                    "texto": "I know. It's too late to go back."
                  },
                  {
                    "texto": "Yes! You sing really well. I sing badly!"
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "What will you be doing when Sara arrives?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  53
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I'll be waiting behind the door.",
                    "ok": true
                  },
                  {
                    "texto": "I know. I'm getting cold, too."
                  },
                  {
                    "texto": "Because it's more fun with you!"
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "Good. Bella has a big house. Maybe we can have the party there."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  12
                ],
                "opciones": [
                  {
                    "texto": "If Bella says yes, we will have it there.",
                    "ok": true
                  },
                  {
                    "texto": "But this hotel is nicer than my old one."
                  },
                  {
                    "texto": "Me too! I'm trying to get to the fruit."
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "Ask her. She's over there."
              }
            ]
          }
        },
        {
          "id": "bella",
          "rol": "target",
          "antes": {
            "quien": "bella",
            "texto": "Hi, Bryan! Talk to Tom first. He has a plan!"
          },
          "ocupado": [
            {
              "quien": "bella",
              "texto": "Go and buy the cake, Bryan!"
            }
          ],
          "dialogo": {
            "requiere": "tom_hablado",
            "pasos": [
              {
                "quien": "bella",
                "texto": "Hi, Bryan! Tom told me about the party. I love it!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  17
                ],
                "opciones": [
                  {
                    "texto": "Can we have it at your house?",
                    "ok": true
                  },
                  {
                    "texto": "Sorry! How long had you been waiting?"
                  },
                  {
                    "texto": "Sure. What do you want to know?"
                  }
                ]
              },
              {
                "quien": "bella",
                "texto": "Of course! But we must keep it a secret."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  12
                ],
                "opciones": [
                  {
                    "texto": "Yes. If Sara finds out, it won't be a surprise.",
                    "ok": true
                  },
                  {
                    "texto": "Only half of it? I'll go to the pharmacy now."
                  },
                  {
                    "texto": "Here it is. I've just found it in my bag."
                  }
                ]
              },
              {
                "quien": "bella",
                "texto": "Exactly. Max will bring the music. Can you buy the cake?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  36
                ],
                "opciones": [
                  {
                    "texto": "Sure. I'll buy it tomorrow morning.",
                    "ok": true
                  },
                  {
                    "texto": "Because of the flowers. They're beautiful."
                  },
                  {
                    "texto": "No, I haven't called him yet."
                  }
                ]
              },
              {
                "quien": "bella",
                "texto": "And what can our friends bring?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  11
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Max can bring music. Tom can bring drinks.",
                    "ok": true
                  },
                  {
                    "texto": "It's a black phone with an orange case."
                  },
                  {
                    "texto": "Don't worry. I'll clean while you finish dinner."
                  }
                ]
              },
              {
                "quien": "bella",
                "texto": "Perfect. Mia's coffee shop has great cakes!"
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "cafe"
              }
            ]
          }
        },
        {
          "id": "max",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "max",
              "texto": "I'm going to play the best songs!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "max",
                "texto": "Hey, Bryan! Did you hear? We're having a party!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  17
                ],
                "opciones": [
                  {
                    "texto": "Yes! You should bring your speaker.",
                    "ok": true
                  },
                  {
                    "texto": "Then take half of my piece!"
                  },
                  {
                    "texto": "The weather is really bad tonight."
                  }
                ]
              },
              {
                "quien": "max",
                "texto": "Sure. I'll play Sara's favorite songs."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  36
                ],
                "opciones": [
                  {
                    "texto": "Great. Are you going to dance, too?",
                    "ok": true
                  },
                  {
                    "texto": "Yes, it is. You like swimming, don't you?"
                  },
                  {
                    "texto": "How long have you lived in this town?"
                  }
                ]
              },
              {
                "quien": "max",
                "texto": "Ha ha, maybe!"
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        }
      ],

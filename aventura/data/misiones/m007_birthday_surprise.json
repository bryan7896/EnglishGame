{
  "id": "m007",
  "titulo": "Birthday surprise plan",
  "titulo_es": "Plan de cumpleaños sorpresa",
  "objetivo": "Plan a surprise party. Sara must not find out!",
  "objetivo_es": "Prepara una fiesta sorpresa. ¡Sara no se puede enterar!",
  "nivel": "A2",
  "resumen": "El sabado es el cumpleanos de Sara. Organiza con tus amigos una fiesta sorpresa, encarga el pastel y que ella no se entere.",
  "musica_inicial": "home_loop",
  "reglas_juego": {

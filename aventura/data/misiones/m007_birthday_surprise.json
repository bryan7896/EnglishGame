    {
      "id": "fiesta",
      "titulo": "Saturday night",
      "fondo": "fiesta_noche",
      "musica": "party_loop",
      "personajes": [
        {
          "id": "sara",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "sara",
                "texto": "Bryan? Why is it so dark in here?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  36
                ],
                "opciones": [
                  {
                    "texto": "Don't worry. You're going to see!",
                    "ok": true
                  },
                  {
                    "texto": "No. I've never eaten here before."
                  },
                  {
                    "texto": "Yes. Your dog runs very fast!"
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "Surprise! Happy birthday, Sara!",
                "efectos": [
                  {
                    "luz": 1
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Oh my! You did all this for me?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  17
                ],
                "opciones": [
                  {
                    "texto": "Of course! You should see your face!",
                    "ok": true
                  },
                  {
                    "texto": "Yes, and I slept during the afternoon!"
                  },
                  {
                    "texto": "Yes. We spent less than last week."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "This is the best birthday ever! Will you all stay for cake?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  12
                ],
                "opciones": [
                  {
                    "texto": "If you cut the cake, we will stay all night!",
                    "ok": true
                  },
                  {
                    "texto": "Yes, please. Bring it to the table by the window."
                  },
                  {
                    "texto": "Thanks. All my friends have left. I need a taxi."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Ha ha! Then let's eat!"
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }

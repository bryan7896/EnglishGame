    {
      "id": "cafe",
      "titulo": "The coffee shop",
      "fondo": "cafe_dia",
      "musica": "party_loop",
      "personajes": [
        {
          "id": "mia",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "mia",
                "texto": "Hi, Bryan! Back again? What can I get you?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  17
                ],
                "opciones": [
                  {
                    "texto": "Could I order a big birthday cake?",
                    "ok": true
                  },
                  {
                    "texto": "Yes. Have you found other people for this job?"
                  },
                  {
                    "texto": "OK. Have you seen anybody near the kitchen?"
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "Sure. When do you need it?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  36
                ],
                "opciones": [
                  {
                    "texto": "We're going to have the party on Saturday.",
                    "ok": true
                  },
                  {
                    "texto": "I know. There isn't any bus before nine."
                  },
                  {
                    "texto": "Half of it? Then she will be sad!"
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "OK. If you pay today, I'll have it ready on Saturday morning."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  12
                ],
                "opciones": [
                  {
                    "texto": "If I pay now, will you write her name on it?",
                    "ok": true
                  },
                  {
                    "texto": "No, I haven't seen it. Is it in the car?"
                  },
                  {
                    "texto": "Is it the figure that was in the glass box?"
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "Of course. What's her name?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  17
                ],
                "opciones": [
                  {
                    "texto": "Sara. You must write it in red, please.",
                    "ok": true
                  },
                  {
                    "texto": "I had been drinking coffee with a friend."
                  },
                  {
                    "texto": "Then somebody must be in the living room!"
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "Do you want to give her a card, too?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  25
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes! We'll give it to her with the cake.",
                    "ok": true
                  },
                  {
                    "texto": "We will! As soon as you have another concert!"
                  },
                  {
                    "texto": "For two nights. We can rest during the day."
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "No problem. See you on Saturday!"
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "fiesta"
              }
            ]
          }
        }
      ],

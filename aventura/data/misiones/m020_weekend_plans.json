    {
      "id": "cafe",
      "titulo": "The coffee shop",
      "fondo": "cafe_dia",
      "musica": "party_loop",
      "personajes": [
        {
          "id": "max",
          "rol": "anfitrion",
          "auto": true,
          "pista": {
            "marca": "lily"
          },
          "dialogo": {
            "pasos": [
              {
                "quien": "max",
                "texto": "The beach? Sure! Who's going to drive?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  36
                ],
                "opciones": [
                  {
                    "texto": "I'm going to ask my dad for his car.",
                    "ok": true
                  },
                  {
                    "texto": "OK... Yes! I got in! Let's talk over dinner!"
                  },
                  {
                    "texto": "No! It was very loud, but I loved it."
                  }
                ]
              },
              {
                "quien": "max",
                "texto": "Cool. This time on Sunday, we'll be swimming!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  53
                ],
                "opciones": [
                  {
                    "texto": "And we'll be eating ice cream!",
                    "ok": true
                  },
                  {
                    "texto": "You need to check these numbers."
                  },
                  {
                    "texto": "Good idea. It's very wet here."
                  }
                ]
              },
              {
                "quien": "max",
                "texto": "Sara doesn't swim, does she?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  29
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No, she doesn't. But Lily does, doesn't she?",
                    "ok": true
                  },
                  {
                    "texto": "You look tired. Had you been working all day?"
                  },
                  {
                    "texto": "Lost? Where had she gone before she called?"
                  }
                ]
              },
              {
                "quien": "max",
                "texto": "Ask Lily. She never comes with us."
              }
            ]
          }
        },
        {
          "id": "lily",
          "rol": "target",
          "antes": {
            "quien": "lily",
            "texto": "Um... hi, Bryan."
          },
          "dialogo": {
            "requiere": "max_hablado",
            "pasos": [
              {
                "quien": "lily",
                "texto": "Um... I can't go. I'll be working all day."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "opciones": [
                  {
                    "texto": "Can you finish by four? We'll wait for you.",
                    "ok": true
                  },
                  {
                    "texto": "I was looking at my phone when it stopped."
                  },
                  {
                    "texto": "But this hotel is nicer than my old one."
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "Um... why do you want me to come?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  49
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Because it's more fun with you!",
                    "ok": true
                  },
                  {
                    "texto": "Good idea. That's the easiest way."
                  },
                  {
                    "texto": "Put it down on the table!"
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "Um... OK! I'll be there by five."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  36
                ],
                "opciones": [
                  {
                    "texto": "Great! It's going to be a perfect day!",
                    "ok": true
                  },
                  {
                    "texto": "A tea with a little milk. Got it."
                  },
                  {
                    "texto": "I know. It's too late to go back."
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "See you on Sunday!"
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }
      ],

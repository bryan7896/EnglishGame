{
  "id": "m020",
  "titulo": "Weekend plans",
  "titulo_es": "Planes de fin de semana",
  "objetivo": "Make plans with your friends for the weekend.",
  "objetivo_es": "Haz planes con tus amigos para el fin de semana.",
  "nivel": "A2-B1",
  "resumen": "Organiza con tus amigos un plan para el domingo en la playa, segun lo que cada uno va a estar haciendo.",
  "musica_inicial": "street_loop",
  "reglas_juego": {
    "modal_reintento": {

  },
  "escenas": [
    {
      "id": "parque",
      "titulo": "The park",
      "fondo": "parque_dia",
      "musica": "street_loop",
      "personajes": [
        {
          "id": "jake",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "sara"
          },
          "ocupado": [
            {
              "quien": "jake",
              "texto": "Ask Sara, Bryan!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "jake",
                "texto": "Bryan, what are you doing this weekend?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  36
                ],
                "opciones": [
                  {
                    "texto": "I'm going to visit my grandmother on Saturday.",
                    "ok": true
                  },
                  {
                    "texto": "Because of the rain. The buses were slow."
                  },
                  {
                    "texto": "Yes, there's a small supermarket on the corner."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Nice! And over the holidays? Where will you go?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  52
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Over the holidays, I'll visit my uncle.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. We spent less than last week."
                  },
                  {
                    "texto": "It's on the left, near the stairs."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Cool. And on Sunday? Let's go to the beach!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  53
                ],
                "opciones": [
                  {
                    "texto": "Sorry. I'll be working on Sunday morning.",
                    "ok": true
                  },
                  {
                    "texto": "I'll give you a new one tomorrow."
                  },
                  {
                    "texto": "Yes, I've taken it out. It's soft!"
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Oh. What about Sunday afternoon?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "opciones": [
                  {
                    "texto": "OK. I'll be free by three o'clock.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I told them dinner was ready."
                  },
                  {
                    "texto": "It's on Green Street, in the city."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "How long will you have been working by Sunday?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  44
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "By Sunday, I'll have been working for six days!",
                    "ok": true
                  },
                  {
                    "texto": "By Friday? OK, it will be ready by then."
                  },
                  {
                    "texto": "I wanted to tell you, but you were cooking."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "If you had more money, where would you go?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  4
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "If I had more money, I would go to the beach.",
                    "ok": true
                  },
                  {
                    "texto": "Ha ha. And I'll have been drinking coffee all night!"
                  },
                  {
                    "texto": "I had my wallet an hour ago, and now it's gone."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Ha ha. Well, on Sunday we can go! Let's ask Sara."
              }
            ]
          }
        },
        {
          "id": "sara",
          "rol": "target",
          "antes": {
            "quien": "sara",
            "texto": "Hi, Bryan! One moment."
          },
          "dialogo": {
            "requiere": "jake_hablado",
            "pasos": [
              {
                "quien": "sara",
                "texto": "The beach on Sunday? I'd love that!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  53
                ],
                "opciones": [
                  {
                    "texto": "Great. What will you be doing in the morning?",
                    "ok": true
                  },
                  {
                    "texto": "That's my phone case! But where is my phone?"
                  },
                  {
                    "texto": "No, I haven't seen her yet. Where is she?"
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "I'll be studying. But I'll finish by noon."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "opciones": [
                  {
                    "texto": "Perfect. By three, we will all be ready.",
                    "ok": true
                  },
                  {
                    "texto": "It's the most beautiful country in the world."
                  },
                  {
                    "texto": "Great! I'll bring the bread while you serve."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "How long are you working on Sunday?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  40
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Only for three hours, during the morning.",
                    "ok": true
                  },
                  {
                    "texto": "Good idea. I'll look them up tonight."
                  },
                  {
                    "texto": "Of course! You should see your face!"
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Last year we went to the mountains. And this year?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  13
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "This year, we'll go to the beach!",
                    "ok": true
                  },
                  {
                    "texto": "Me too. I still hope he's lucky."
                  },
                  {
                    "texto": "We live at number ten, Main Street."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Great! Ask Max and Lily at the coffee shop."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "cafe"
              }
            ]
          }
        }
      ],
      "objetos": [

    {
      "id": "parque",
      "titulo": "The park",
      "fondo": "parque_dia",
      "musica": "street_loop",
      "personajes": [
        {
          "id": "hank",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "hank",
                "texto": "Good afternoon. Are you looking for something?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  15
                ],
                "opciones": [
                  {
                    "texto": "Yes, my wallet. A man took it and left.",
                    "ok": true
                  },
                  {
                    "texto": "And this is the best steak I've ever had!"
                  },
                  {
                    "texto": "Me too. I want to learn to cook pizza."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "A man gave me this wallet. He had found it in the coffee shop."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  43,
                  13
                ],
                "opciones": [
                  {
                    "texto": "So he had found it, not taken it!",
                    "ok": true
                  },
                  {
                    "texto": "By Sunday, I'll have been working for six days!"
                  },
                  {
                    "texto": "It was sunny an hour ago. Now it's cloudy."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Yes. He was looking for you. What's in your wallet?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  13
                ],
                "opciones": [
                  {
                    "texto": "My card. I will show you my name on it.",
                    "ok": true
                  },
                  {
                    "texto": "Good. By six, we'll have been working for ten hours!"
                  },
                  {
                    "texto": "OK. I'll take it off and put it down here."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Is your name on the card?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  23
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Let me look at it. Yes, it's mine!",
                    "ok": true
                  },
                  {
                    "texto": "But she loves our house. She always says that."
                  },
                  {
                    "texto": "Yes! We can plan the weekend over ice cream."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Here you are. Next time, be more careful!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  43
                ],
                "opciones": [
                  {
                    "texto": "I will. I had never lost my wallet before!",
                    "ok": true
                  },
                  {
                    "texto": "Yes. It was used this morning, then it stopped."
                  },
                  {
                    "texto": "Yes! We'll give it to her with the cake."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "What had you been doing when you lost it?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  1
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I had been talking with my friends.",
                    "ok": true
                  },
                  {
                    "texto": "Sorry. I'll be working on Sunday morning."
                  },
                  {
                    "texto": "Yes. It's the best beach I know."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Have a good day, Bryan."
              }
            ],
            "al_terminar": [

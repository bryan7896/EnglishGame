      "personajes": [
        {
          "id": "mia",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "george"
          },
          "ocupado": [
            {
              "quien": "mia",
              "texto": "Ask George, Bryan. He was here."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "mia",
                "texto": "Hi, Bryan! Did you forget something?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  43
                ],
                "opciones": [
                  {
                    "texto": "Yes. I think I had left my wallet on this table.",
                    "ok": true
                  },
                  {
                    "texto": "Wow! By then, you'll have been living here a long time."
                  },
                  {
                    "texto": "By next year, I'll have been studying for three years."
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "Hmm. After you left, a man sat at that table. Then he went out."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  15
                ],
                "opciones": [
                  {
                    "texto": "Has he gone? Where did he go?",
                    "ok": true
                  },
                  {
                    "texto": "So you're here because of your house?"
                  },
                  {
                    "texto": "OK. Is the park on Main Street?"
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "I don't know. But George was here, too. Ask him."
              }
            ]
          }
        },
        {
          "id": "george",
          "rol": "target",
          "antes": {
            "quien": "george",
            "texto": "Hmm? One moment, my boy."
          },
          "dialogo": {
            "requiere": "mia_hablado",
            "pasos": [
              {
                "quien": "george",
                "texto": "Oh, hello, Bryan. A wallet? What had you been doing before you lost it?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  1
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I had been drinking coffee with a friend.",
                    "ok": true
                  },
                  {
                    "texto": "I've waited for it over the last two months!"
                  },
                  {
                    "texto": "Don't worry. I'll bring it from the car."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Hmm... a black wallet?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  43
                ],
                "opciones": [
                  {
                    "texto": "Did you see it? I had put it next to my cup.",
                    "ok": true
                  },
                  {
                    "texto": "Wow! By then, you'll have been living together for fifty years!"
                  },
                  {
                    "texto": "Thank you! I've waited for this day for a long time."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Yes! When I came in, the man had already taken something black."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  13
                ],
                "opciones": [
                  {
                    "texto": "So he had taken it before you arrived?",
                    "ok": true
                  },
                  {
                    "texto": "Good idea. I'll buy water while we wait."
                  },
                  {
                    "texto": "Bananas. Can you look for some good bananas?"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "I think so. He has gone to the park. Hurry!"
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "parque"
              }
            ]
          }
        },
        {
          "id": "bella",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "bella",
              "texto": "Good luck, Bryan!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "bella",
                "texto": "Bryan! What's wrong? You look worried."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  13
                ],
                "opciones": [
                  {
                    "texto": "I had my wallet an hour ago, and now it's gone.",
                    "ok": true
                  },
                  {
                    "texto": "Half of a spoon, two times a day. OK."
                  },
                  {
                    "texto": "Yes! We'll give it to her with the cake."
                  }
                ]
              },
              {
                "quien": "bella",
                "texto": "Oh no! Where is the man now?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  15
                ],
                "opciones": [
                  {
                    "texto": "He has gone to the park, I think.",
                    "ok": true
                  },
                  {
                    "texto": "Ha ha. You've never given me money before!"
                  },
                  {
                    "texto": "Wow! Nobody has given me a photo before!"
                  }
                ]
              },
              {
                "quien": "bella",
                "texto": "Do you think you'll find it?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  26
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I still hope so!",
                    "ok": true
                  },
                  {
                    "texto": "I've been ready since seven o'clock!"
                  },
                  {
                    "texto": "For forty minutes!"
                  }
                ]
              },
              {
                "quien": "bella",
                "texto": "Run, then!"
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        }
      ],

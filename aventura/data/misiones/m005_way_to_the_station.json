  "escenas": [
    {
      "id": "calle",
      "titulo": "Your street",
      "fondo": "ciudad_dia",
      "musica": "street_loop",
      "personajes": [
        {
          "id": "george",
          "rol": "guia_inicial",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "george",
                "texto": "Bryan, where are you going with that bag?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  16
                ],
                "opciones": [
                  {
                    "texto": "I'm going to the train station.",
                    "ok": true
                  },
                  {
                    "texto": "Good idea. It's very wet here."
                  },
                  {
                    "texto": "OK. I'll take the cheaper bananas."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "The station? What time is your train?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  33
                ],
                "opciones": [
                  {
                    "texto": "It's at ten thirty. How far is it?",
                    "ok": true
                  },
                  {
                    "texto": "Can you bring the lamp to the house?"
                  },
                  {
                    "texto": "Bananas. Can you look for some good bananas?"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "It's about two kilometers. You need to go through the park."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  39
                ],
                "opciones": [
                  {
                    "texto": "OK. Is the park on Main Street?",
                    "ok": true
                  },
                  {
                    "texto": "Can you call a taxi for us?"
                  },
                  {
                    "texto": "I paid online. That's strange, isn't it?"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Yes. Go now, and ask Lily in the park. Hurry!"
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "parque"
              }
            ]
          }
        }
      ],
      "objetos": [
        {
          "id": "traffic_light",
          "svg": "traffic_light",
          "texto_ref": "traffic_light"
        },
        {
          "id": "sign",
          "svg": "sign",
          "texto_ref": "sign"
        },
        {
          "id": "street_lamp",
          "svg": "street_lamp",
          "texto_ref": "street_lamp"
        },
        {
          "id": "bag",
          "svg": "bag",
          "texto_ref": "bag"
        }
      ]
    },
    {
      "id": "parque",
      "titulo": "The park",
      "fondo": "parque_dia",
      "musica": "street_loop",
      "personajes": [
        {
          "id": "lily",
          "rol": "target",
          "pista": {
            "marca": "bridge"
          },
          "ocupado": [
            {
              "quien": "lily",
              "texto": "Um... hurry, Bryan! Cross the bridge."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "lily",
                "texto": "Hi, Bryan! Are you lost?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  16
                ],
                "opciones": [
                  {
                    "texto": "A little. How do I get to the station?",
                    "ok": true
                  },
                  {
                    "texto": "Thank you. What does the book look like?"
                  },
                  {
                    "texto": "Great. What will you be doing in the morning?"
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "Walk across the bridge. Then turn left."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  39
                ],
                "opciones": [
                  {
                    "texto": "So the station is on the left?",
                    "ok": true
                  },
                  {
                    "texto": "I will. People like stories, don't they?"
                  },
                  {
                    "texto": "Yes. Which eggs are the cheapest?"
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "Yes, next to the big supermarket. You can't miss it."
              },
              {
                "quien": "lily",
                "texto": "Do you know where the supermarket is?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  39
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. It's on Main Street, near the bank.",
                    "ok": true
                  },
                  {
                    "texto": "If we came every week, I'd love it!"
                  },
                  {
                    "texto": "My friend got sick. He feels very hot."
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "Good. Then you can't get lost.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  33
                ],
                "opciones": [
                  {
                    "texto": "Thanks! Is it a long walk?",
                    "ok": true
                  },
                  {
                    "texto": "Sure. Is it a chocolate cake?"
                  },
                  {
                    "texto": "Have you eaten any cake today?"
                  }
                ]
              },
              {
                "quien": "lily",
                "texto": "No, it's only ten minutes. But hurry!"
              }
            ],
            "al_terminar": [
              {
                "habilita": "bridge"
              }
            ]
          }
        },
        {
          "id": "hank",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "hank",
              "texto": "The station is across the bridge."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "hank",
                "texto": "Good morning. Please don't walk on the grass."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  39
                ],
                "opciones": [
                  {
                    "texto": "Sorry! I'm in a hurry for my train.",
                    "ok": true
                  },
                  {
                    "texto": "I think there are a few sandwiches left."
                  },
                  {
                    "texto": "I had been cleaning the house all day."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "OK, OK. The station is across the bridge."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  16
                ],
                "opciones": [
                  {
                    "texto": "Thank you! I need to get to it fast.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. It's on the corner, next to the tree."
                  },
                  {
                    "texto": "I'm going to study with you at the library."
                  }
                ]
              },
              {
                "quien": "hank",
                "texto": "Then run! Have a good trip."
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        }
      ],
      "objetos": [
        {
          "id": "bench",
          "svg": "bench",
          "texto_ref": "bench"
        },
        {
          "id": "tree",

    {
      "id": "estacion",
      "titulo": "The train station",
      "fondo": "estacion_tren",
      "musica": "ride_loop",
      "personajes": [
        {
          "id": "sam",
          "rol": "target",
          "dialogo": {
            "pasos": [
              {
                "quien": "sam",
                "texto": "Good morning. Can I help you?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  16
                ],
                "opciones": [
                  {
                    "texto": "Yes. One ticket to River Town, please.",
                    "ok": true
                  },
                  {
                    "texto": "Sure. A sandwich and an orange juice."
                  },
                  {
                    "texto": "Yes. I still hope they say yes."
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "Here you are. That's fifteen dollars."
              },
              {
                "quien": "sam",
                "texto": "Do you want a seat next to the window?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  42
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes, please. A window seat is great.",
                    "ok": true
                  },
                  {
                    "texto": "Wow, half of them? That's a lot!"
                  },
                  {
                    "texto": "Yes, it's more expensive, but it's safer."
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "OK. Seat twelve, next to the window.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  33
                ],
                "opciones": [
                  {
                    "texto": "Thanks. What time is it now?",
                    "ok": true
                  },
                  {
                    "texto": "Sure. Can I use your pen?"
                  },
                  {
                    "texto": "Yes, please. Could you take us home?"
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "It's ten twenty-five. Your train is the green one."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  39
                ],
                "opciones": [
                  {
                    "texto": "Great! Does it leave from here?",
                    "ok": true
                  },
                  {
                    "texto": "So you're here because of your house?"
                  },
                  {
                    "texto": "Why did you move to this street?"
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "Yes, in five minutes. It's cold in River Town today."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  33
                ],
                "opciones": [
                  {
                    "texto": "Thanks! Is it very cold there?",
                    "ok": true
                  },
                  {
                    "texto": "Could I order a big birthday cake?"
                  },
                  {
                    "texto": "How can we get to the university?"
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "Yes, it's snowing there. Have a good trip!"
              },
              {
                "quien": "sam",
                "texto": "Wait! Do you have your ticket with you?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  3
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. Here's my train ticket.",
                    "ok": true
                  },
                  {
                    "texto": "Let's call the building manager."
                  },
                  {
                    "texto": "No, it hasn't arrived yet."
                  }
                ]
              },
              {
                "quien": "sam",
                "texto": "Good. Show it on the train.",
                "refuerzo": true
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }
      ],
      "objetos": [

          "id": "flowers",
          "svg": "flowers",
          "texto_ref": "flowers"
        },
        {
          "id": "bridge",
          "svg": "bridge",
          "texto_ref": "bridge",
          "inicia_deshabilitado": true,
          "dialogo": {
            "requiere": "bridge",
            "pasos": [
              {
                "quien": "bryan",
                "reglaIds": [
                  16
                ],
                "opciones": [
                  {
                    "texto": "Let's walk across the bridge to the station.",
                    "ok": true
                  },
                  {
                    "texto": "A piece of cake and an apple juice."
                  },
                  {
                    "texto": "I still hope I can see one song!"
                  }
                ]
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "estacion"
              }
            ]
          }
        }
      ]

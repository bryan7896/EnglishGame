{
  "id": "m005",
  "titulo": "Which way to the station?",
  "titulo_es": "¿Por dónde queda la estación?",
  "objetivo": "Get to the train station on time. Ask for directions.",
  "objetivo_es": "Llega a tiempo a la estación de tren. Pide indicaciones.",
  "nivel": "A2",
  "resumen": "Tienes que tomar el tren de las diez y media. Pide indicaciones por la calle y el parque hasta llegar a la estacion.",
  "musica_inicial": "street_loop",
  "reglas_juego": {
    "modal_reintento": {
      "color": "naranja",
      "opciones": 2
    },
    "tercer_error": "revelar_correcta_sin_puntos_y_a_repaso",

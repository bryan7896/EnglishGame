          "rol": "target",
          "antes": {
            "quien": "mia",
            "texto": "Hi! Ask your friends what they want first."
          },
          "dialogo": {
            "requiere": "pedidos_listos",
            "pasos": [
              {
                "quien": "mia",
                "texto": "Hi! Welcome to the coffee shop. What can I get you?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  6
                ],
                "opciones": [
                  {
                    "texto": "Hi! I need to order for four people.",
                    "ok": true
                  },
                  {
                    "texto": "Tell her to go to the information desk."
                  },
                  {
                    "texto": "If it were free, we would take it!"
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "No problem. What would you like?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  22
                ],
                "opciones": [
                  {
                    "texto": "A tea, a sandwich and an orange juice, please.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, my wallet. A man took it and left."
                  },
                  {
                    "texto": "By tonight, we'll have been working for twelve hours."
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "OK. And for the fourth person?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  22
                ],
                "opciones": [
                  {
                    "texto": "A piece of cake and an apple juice.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. It's the oldest car on the street!"
                  },
                  {
                    "texto": "It's at Sara's house now. It's very close."
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "Do you want sugar in the tea?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  37
                ],
                "opciones": [
                  {
                    "texto": "Just a little sugar, please.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, here's my bus ticket."
                  },
                  {
                    "texto": "I work as an engineer."
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "And how many cookies do you want? We only have a few."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  37
                ],
                "opciones": [
                  {
                    "texto": "Not many. How much are they?",
                    "ok": true
                  },
                  {
                    "texto": "Of course. Can we sit together?"
                  },
                  {
                    "texto": "Wow! When was it last checked?"
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "They're two dollars each. So, twenty-two dollars, please."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  6
                ],
                "opciones": [
                  {
                    "texto": "Here you are. Do I need to wait here?",
                    "ok": true
                  },
                  {
                    "texto": "Is it the lamp that was in your house?"
                  },
                  {
                    "texto": "You look tired. Had you been working all day?"
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "No, you don't need to wait. I can bring it to your table."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  6
                ],
                "opciones": [
                  {
                    "texto": "Great! We need to leave at ten.",
                    "ok": true
                  },
                  {
                    "texto": "It's on Green Street, in the city."
                  },
                  {
                    "texto": "OK. I'll be free by three o'clock."
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "Do you want me to make some coffee too?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  14
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes, please. Can you make a big coffee?",
                    "ok": true
                  },
                  {
                    "texto": "I'm a student. And where do you work?"
                  },
                  {
                    "texto": "Good evening. Could you take us home, please?"
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "So I'll bring the food to your table, OK?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  11
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes, please. Bring it to the table by the window.",
                    "ok": true
                  },
                  {
                    "texto": "Excuse me. I left my phone on a bus seat."
                  },
                  {
                    "texto": "My card. I will show you my name on it."
                  }
                ]
              },
              {
                "quien": "mia",
                "texto": "No problem. Your food is ready in five minutes!"

          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "joe",
                "texto": "Hi! Are you the one who called about the elevator?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  45
                ],
                "opciones": [
                  {
                    "texto": "Yes. It was used this morning, then it stopped.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, corn for my dad. He cooks with us."
                  },
                  {
                    "texto": "Yes. This shop is better than the old one."
                  }
                ]
              },
              {
                "quien": "joe",
                "texto": "Hmm. The door might be the problem. Or the power."
              },
              {
                "quien": "joe",
                "texto": "Which door is the problem?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  3
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "The elevator door. It doesn't close.",
                    "ok": true
                  },
                  {
                    "texto": "So the figure was returned! Great!"
                  },
                  {
                    "texto": "Then take half of my piece!"
                  }
                ]
              },
              {
                "quien": "joe",
                "texto": "OK. Or maybe it's the power.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  46
                ],
                "opciones": [
                  {
                    "texto": "It can't be the power. The lights are on.",
                    "ok": true
                  },
                  {
                    "texto": "For two nights. We can rest during the day."
                  },
                  {
                    "texto": "Yes. And half of the things were on sale."
                  }
                ]
              },
              {
                "quien": "joe",
                "texto": "Good point. Now, where is my repair box?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  3
                ],
                "opciones": [
                  {
                    "texto": "Maybe it's in your car park.",
                    "ok": true
                  },
                  {
                    "texto": "And we'll be eating ice cream!"
                  },
                  {
                    "texto": "Great! I've never made pasta before."
                  }
                ]
              },
              {
                "quien": "joe",
                "texto": "Yes, there it is! The elevator will be repaired in an hour."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  45
                ],
                "opciones": [
                  {
                    "texto": "Great! Can it be checked every month?",
                    "ok": true
                  },
                  {
                    "texto": "Yes, please. Could you take us home?"
                  },
                  {
                    "texto": "I will. People like stories, don't they?"
                  }
                ]
              },
              {
                "quien": "joe",
                "texto": "Good idea. I'll tell the manager."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  46
                ],
                "opciones": [
                  {
                    "texto": "Thanks! Linda must be very happy now.",
                    "ok": true
                  },
                  {
                    "texto": "Not many. Only a few cookies today."
                  },
                  {
                    "texto": "I had been talking with my friends."
                  }
                ]
              },
              {
                "quien": "joe",
                "texto": "Ha ha. I hope so!"

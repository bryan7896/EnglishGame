                  {
                    "texto": "Had she already taken the train?"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Who knows! It might be older than me!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  46
                ],
                "opciones": [
                  {
                    "texto": "Ha ha. It can't be older than you!",
                    "ok": true
                  },
                  {
                    "texto": "It's at Sara's house now. It's very close."
                  },
                  {
                    "texto": "No, I think it's going to the airport."

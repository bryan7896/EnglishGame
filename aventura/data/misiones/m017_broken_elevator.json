                "reglaIds": [
                  46
                ],
                "opciones": [
                  {
                    "texto": "Really? It must be broken.",
                    "ok": true
                  },
                  {
                    "texto": "Because I like teaching English."
                  },
                  {
                    "texto": "I need it by Friday."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "I have three heavy bags, and I live on the fifth floor!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  3
                ],
                "opciones": [
                  {
                    "texto": "Let's call the building manager.",
                    "ok": true
                  },
                  {
                    "texto": "We'll be walking in Japan!"
                  },
                  {
                    "texto": "Just a little sugar, please."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Good idea. His phone number is next to the elevator."

                ]
              },
              {
                "quien": "max",
                "texto": "Great! What will we be doing there?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  53
                ],
                "opciones": [
                  {
                    "texto": "We'll be eating your cake and listening to music!",
                    "ok": true
                  },
                  {
                    "texto": "By tonight, we'll have been working for twelve hours."
                  },
                  {
                    "texto": "I will. Thanks! I can't do anything without it."

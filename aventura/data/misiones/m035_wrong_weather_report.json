        {
          "id": "max",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "max",
                "texto": "Hey! Where's my party? It's raining a lot!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  33
                ],
                "opciones": [
                  {
                    "texto": "It's at Sara's house now. It's very close.",
                    "ok": true

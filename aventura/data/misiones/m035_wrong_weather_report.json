                ]
              },
              {
                "quien": "max",
                "texto": "Ha ha! The weather report was really wrong, wasn't it?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  13
                ],
                "opciones": [
                  {
                    "texto": "Yes! Next time, I'll look at the sky.",

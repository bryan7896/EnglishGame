            "pasos": [
              {
                "quien": "sara",
                "texto": "Bryan! It's going to rain. I just saw it on my phone."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  33
                ],
                "opciones": [
                  {
                    "texto": "Is it going to rain a lot?",
                    "ok": true
                  },
                  {
                    "texto": "I will. People like stories, don't they?"
                  },
                  {
                    "texto": "Oh no! When did you get sick?"
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Yes. The report was wrong. It will rain in ten minutes."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  13
                ],
                "opciones": [
                  {
                    "texto": "This morning it said sun. Now it says rain!",
                    "ok": true
                  },
                  {
                    "texto": "I will. I had never lost my wallet before!"
                  },
                  {
                    "texto": "OK... Yes! I got in! Let's talk over dinner!"
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Do you still hope it doesn't rain?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  26
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. I still hope the sun comes back.",
                    "ok": true
                  },
                  {
                    "texto": "Great! I'll bring the bread while you serve."
                  },
                  {
                    "texto": "In March, I think. On the first day."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "What will you be doing at five?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  53
                ],
                "opciones": [
                  {
                    "texto": "I'll be helping you with the cake.",
                    "ok": true
                  },
                  {
                    "texto": "I don't know. Somebody has taken them."
                  },
                  {
                    "texto": "I've known her since she moved here."
                  }
                ]
              },
              {
                "quien": "sara",
                "texto": "Then let's take everything to my house. It's very near."
              }
            ],

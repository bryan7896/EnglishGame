          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "jake",
                "texto": "The weather report said it would be sunny all day!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  33
                ],
                "opciones": [
                  {
                    "texto": "Yes, and it's really hot today.",
                    "ok": true
                  },
                  {
                    "texto": "We will! We enjoy studying here."
                  },
                  {
                    "texto": "Yes. It was taken this morning."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Max is coming at four. We'll be eating cake in the park!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  53
                ],
                "opciones": [
                  {
                    "texto": "And we'll be playing music all afternoon!",
                    "ok": true
                  },
                  {
                    "texto": "The one that you sang last night!"
                  },
                  {
                    "texto": "I didn't see anybody in the kitchen."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "What are you going to bring?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  36
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I'm going to bring the music.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. And it's getting dark, too."
                  },
                  {
                    "texto": "Yes, there are too many people."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Max wants everything ready before four.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "It will be ready by four.",
                    "ok": true
                  },
                  {
                    "texto": "Yes! I still hope she's OK."
                  },
                  {
                    "texto": "OK. I'll take the cheaper bananas."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Look at the sky! Those clouds weren't there before."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  13
                ],
                "opciones": [
                  {
                    "texto": "It was sunny an hour ago. Now it's cloudy.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. It's on the corner, next to the tree."
                  },
                  {
                    "texto": "Yes, corn for my dad. He cooks with us."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Oh no. Ask Sara. She knows a lot about the weather."
              }

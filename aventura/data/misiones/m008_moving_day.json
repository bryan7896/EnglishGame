    {
      "id": "cocina",
      "titulo": "The kitchen",
      "fondo": "cocina_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "jake",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "jake",
                "texto": "My grandmother gave me these glasses."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  25
                ],
                "opciones": [
                  {
                    "texto": "They're beautiful. When did she give them to you?",
                    "ok": true
                  },
                  {
                    "texto": "Here you are. Do I need to wait here?"
                  },
                  {
                    "texto": "That's my phone case! But where is my phone?"
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Last year. Be careful with them!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  19
                ],
                "opciones": [
                  {
                    "texto": "Oh no! I've broken one glass. I'm sorry!",
                    "ok": true
                  },
                  {
                    "texto": "Yes. It's on Main Street, near the bank."
                  },
                  {
                    "texto": "They'll answer by the end of the month."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Ha ha, don't worry. It's only one."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  25
                ],
                "opciones": [
                  {
                    "texto": "I'll give you a new one tomorrow.",
                    "ok": true
                  },
                  {
                    "texto": "Of course! You should see your face!"
                  },
                  {
                    "texto": "Me too. I still hope he's lucky."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Deal! Thanks for your help today, Bryan."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  11
                ],
                "opciones": [
                  {
                    "texto": "Any time! Next time, bring pizza for us!",
                    "ok": true
                  },
                  {
                    "texto": "Really? I thought you had gone in already."
                  },
                  {
                    "texto": "Let's walk across the bridge to the station."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Ha ha! OK, I will."
              },
              {
                "quien": "jake",
                "texto": "Have you ever moved to a new house?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  10
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes, I've moved two times.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, I brought it inside."
                  },
                  {
                    "texto": "Yes, I've already finished it."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Then you know it's a lot of work!",
                "refuerzo": true
              }
            ],
            "al_terminar": [

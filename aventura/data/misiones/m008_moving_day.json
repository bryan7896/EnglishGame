    {
      "id": "sala",
      "titulo": "Jake's new home",
      "fondo": "sala_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "jake",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "jake",
                "texto": "Wait, where is the box with my books? Have you seen it?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  19
                ],
                "opciones": [
                  {
                    "texto": "No, I haven't seen it. Is it in the car?",
                    "ok": true
                  },
                  {
                    "texto": "Oh no, it has left? When is the next one?"
                  },
                  {
                    "texto": "No, I'm not. It's a crazy story, isn't it?"
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "I didn't bring it. I only brought the lamp."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  11
                ],
                "opciones": [
                  {
                    "texto": "Don't worry. I'll bring it from the car.",
                    "ok": true
                  },
                  {
                    "texto": "OK. I'll take my bag to the room."
                  },
                  {
                    "texto": "Yes, there's a small supermarket on the corner."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "What do we need to do now?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  14
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Let's do the kitchen, then make the bed.",
                    "ok": true
                  },
                  {
                    "texto": "Perfect. By three, we will all be ready."
                  },
                  {
                    "texto": "Yes. But I fell badly in the rain."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Thanks! Now let's go to the kitchen."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "cocina"
              }
            ]
          }
        }

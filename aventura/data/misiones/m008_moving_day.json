  "escenas": [
    {
      "id": "calle",
      "titulo": "Moving day",
      "fondo": "ciudad_dia",
      "musica": "street_loop",
      "personajes": [
        {
          "id": "jake",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "tom"
          },
          "ocupado": [
            {
              "quien": "jake",
              "texto": "Help Tom with the boxes, man!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "jake",
                "texto": "Thanks for coming, Bryan! Look at all these boxes."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  11
                ],
                "opciones": [
                  {
                    "texto": "No problem. I brought some water for us.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, a lot over the last two years."
                  },
                  {
                    "texto": "I work as an engineer on this project."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Great! Tom is coming, too. Did he call you?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  19
                ],
                "opciones": [
                  {
                    "texto": "Yes. He has taken the bus already.",
                    "ok": true
                  },
                  {
                    "texto": "I had been talking with my friends."
                  },
                  {
                    "texto": "Yes, I love studying here. It's quiet."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Cool. Look, he's here!"
              }
            ]
          }
        },
        {
          "id": "tom",
          "rol": "target",
          "antes": {
            "quien": "tom",
            "texto": "Hey, Bryan! One moment."
          },
          "ocupado": [
            {
              "quien": "tom",
              "texto": "Come on, let's go inside!"
            }
          ],
          "dialogo": {
            "requiere": "jake_hablado",
            "pasos": [
              {
                "quien": "tom",
                "texto": "Sorry I'm late! What do you need?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  11
                ],
                "opciones": [
                  {
                    "texto": "Can you bring the lamp to the house?",
                    "ok": true
                  },
                  {
                    "texto": "No, not yet. Can you sing it again?"
                  },
                  {
                    "texto": "Yes. Did you see the person who took it?"
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "Sure. Who gave Jake all these plates?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  25
                ],
                "opciones": [
                  {
                    "texto": "His mother gave them to him.",
                    "ok": true
                  },
                  {
                    "texto": "We will! We enjoy studying here."
                  },
                  {
                    "texto": "Yes! I still hope she's OK."
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "Nice. Let's take them inside."
              },
              {
                "quien": "tom",
                "texto": "Have you seen the keys? Jake can't find them.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  19
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. I've put them in the car.",
                    "ok": true
                  },
                  {
                    "texto": "Over the holidays, I'll visit my uncle."
                  },
                  {
                    "texto": "Good idea. I'll look them up tonight."
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "Great. I'll tell him.",
                "refuerzo": true
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "sala"
              }
            ]
          }
        },
        {
          "id": "linda",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "linda",
              "texto": "Welcome to the street!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "linda",
                "texto": "Hi! Is your friend moving to this street?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  19
                ],
                "opciones": [
                  {
                    "texto": "Yes. He has left his old apartment.",
                    "ok": true
                  },
                  {
                    "texto": "No, sorry. It's for the new neighbor."
                  },
                  {
                    "texto": "Late. You had already played three songs."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Welcome! Tell him I can give him some flowers."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  25
                ],
                "opciones": [
                  {
                    "texto": "Thank you! Please give them to him later.",
                    "ok": true
                  },
                  {
                    "texto": "I worked as a waiter for a year."
                  },
                  {
                    "texto": "Don't worry. By Friday, everything will be ready."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Sure!"
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        }
      ],

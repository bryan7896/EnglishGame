      "personajes": [
        {
          "id": "linda",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "linda",
                "texto": "Bryan! People are saying you're moving to another city. You aren't, are you?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  29
                ],
                "opciones": [
                  {
                    "texto": "No, I'm not! You don't believe it, do you?",
                    "ok": true
                  },
                  {
                    "texto": "We were worried! Where had you been all day?"
                  },
                  {
                    "texto": "Great. Do I need a towel for the pool?"
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "No! But Rosa told me. She works at the shop."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  21
                ],
                "opciones": [
                  {
                    "texto": "What exactly did she tell you?",
                    "ok": true
                  },
                  {
                    "texto": "Wow! When was it last checked?"
                  },
                  {
                    "texto": "Yes. Which eggs are the cheapest?"
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "She said that your mom was selling the house."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  20
                ],
                "opciones": [
                  {
                    "texto": "My mom never sells anything!",
                    "ok": true
                  },
                  {
                    "texto": "For forty minutes!"
                  },
                  {
                    "texto": "Just a little sugar, please."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Ha ha. Go and ask Rosa at the shop."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "tienda"
              }
            ]
          }
        },
        {
          "id": "tom",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "tom",
              "texto": "Good! Don't leave, man!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "tom",
                "texto": "Hey, Bryan, I heard you're leaving! You're not, are you?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  29
                ],
                "opciones": [
                  {
                    "texto": "No, I'm not. It's a crazy story, isn't it?",
                    "ok": true
                  },
                  {
                    "texto": "OK. Do I need to bring it back soon?"
                  },
                  {
                    "texto": "If you win, will you buy a new car?"
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "Ha ha! Good. Who told everybody?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  21
                ],
                "opciones": [
                  {
                    "texto": "I don't know. I'll tell you later.",
                    "ok": true
                  },
                  {
                    "texto": "Don't worry. Put the lights on first."
                  },
                  {
                    "texto": "To Japan. Our flight is at ten."
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "OK!"
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }

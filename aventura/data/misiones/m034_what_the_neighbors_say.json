      "fondo": "tienda_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "rosa",
          "rol": "anfitrion",
          "auto": true,
          "pista": {
            "marca": "pedro"
          },
          "ocupado": [
            {
              "quien": "rosa",
              "texto": "Ask Pedro, Bryan!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "rosa",
                "texto": "Hi, Bryan! Your mom is moving, isn't she?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  29
                ],
                "opciones": [
                  {
                    "texto": "No, she isn't! Who told you that?",
                    "ok": true
                  },
                  {
                    "texto": "Yes. What did the woman look like?"
                  },
                  {
                    "texto": "Can I help you take it off?"
                  }
                ]
              },
              {
                "quien": "rosa",
                "texto": "Pedro said it. He says your mom wants a bigger house."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  20
                ],
                "opciones": [
                  {
                    "texto": "But she loves our house. She always says that.",
                    "ok": true
                  },
                  {
                    "texto": "If you bought it, we would have a party!"
                  },
                  {
                    "texto": "We need to cut the onions before cooking them."
                  }
                ]
              },
              {
                "quien": "rosa",
                "texto": "Hmm. What did your mom say to you?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  21
                ],
                "opciones": [
                  {
                    "texto": "She told me nothing about moving.",
                    "ok": true
                  },
                  {
                    "texto": "OK. Let's swim for an hour."
                  },
                  {
                    "texto": "The elevator door. It doesn't close."
                  }
                ]
              },
              {
                "quien": "rosa",
                "texto": "Where did your mom go today?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  41
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I don't know where she went.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I'm looking for the bread."
                  },
                  {
                    "texto": "OK. I'll take them off now."
                  }
                ]
              },
              {
                "quien": "rosa",
                "texto": "Then ask Pedro. He's over there."
              }
            ]
          }
        },
        {
          "id": "pedro",
          "rol": "target",
          "antes": {
            "quien": "pedro",
            "texto": "One moment, young man!"
          },
          "dialogo": {
            "requiere": "rosa_hablado",
            "pasos": [
              {
                "quien": "pedro",
                "texto": "Hello, young man! Fresh fruit?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  21
                ],
                "opciones": [
                  {
                    "texto": "No, thanks. Did you tell Rosa we're moving?",
                    "ok": true
                  },
                  {
                    "texto": "Is it the book that the teacher likes?"
                  },
                  {
                    "texto": "Lost? Where had she gone before she called?"
                  }
                ]
              },
              {
                "quien": "pedro",
                "texto": "Oh! Your mom said she wanted a bigger garden, not a new house!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  20
                ],
                "opciones": [
                  {
                    "texto": "Ha ha! She wants a bigger garden, not a house!",
                    "ok": true
                  },
                  {
                    "texto": "Here it is. I've just found it in my bag."
                  },
                  {
                    "texto": "I've checked the mail every day over the last week."
                  }
                ]
              },
              {
                "quien": "pedro",
                "texto": "Sorry! I didn't hear well. Tell everybody it's not true."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  29
                ],
                "opciones": [
                  {
                    "texto": "I will. People like stories, don't they?",
                    "ok": true
                  },
                  {
                    "texto": "Could I order a big birthday cake?"
                  },
                  {
                    "texto": "Please! Can you give us one minute?"
                  }
                ]
              },
              {
                "quien": "pedro",
                "texto": "Ha ha, they do!"
              }
            ],

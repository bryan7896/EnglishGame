  "escenas": [
    {
      "id": "puerta",
      "titulo": "Your house",
      "fondo": "casa_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "george",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "george",
                "texto": "Hello, Bryan! Surprise! We're early!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  21
                ],
                "opciones": [
                  {
                    "texto": "Hi! Mom told me you would come at seven.",
                    "ok": true
                  },
                  {
                    "texto": "By Sunday, I'll have been working for six days!"
                  },
                  {
                    "texto": "Yes! We can plan the weekend over ice cream."
                  }
                ]
              },
              {
                "quien": "linda",
                "texto": "Sorry, Bryan! I wanted to see your garden."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  40
                ],
                "opciones": [
                  {
                    "texto": "No problem. Mom has cooked for three hours!",
                    "ok": true
                  },
                  {
                    "texto": "I know. There isn't any bus before nine."
                  },
                  {
                    "texto": "I had been drinking coffee with a friend."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Here, this is for your mom.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  25
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Thank you! I'll give it to her.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. We're looking for a grammar book."
                  },
                  {
                    "texto": "Great! We need to leave at ten."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Great! Can we come in?"
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "sala"
              }
            ]
          }
        }
      ],
      "objetos": [

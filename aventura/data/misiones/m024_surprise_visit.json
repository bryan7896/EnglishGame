    {
      "id": "cocina",
      "titulo": "Dinner",
      "fondo": "cocina_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "mom",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "mom",
                "texto": "Did you tell them to sit down?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  21
                ],
                "opciones": [
                  {
                    "texto": "Yes. I told them dinner was ready.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I've put them in the car."
                  },
                  {
                    "texto": "Yes, I enjoy cooking for my family."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Good. Let's eat while the soup is hot."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  35
                ],
                "opciones": [
                  {
                    "texto": "Great! I'll bring the bread while you serve.",
                    "ok": true
                  },
                  {
                    "texto": "Thank you! Please give them to him later."
                  },
                  {
                    "texto": "Yes. It's on Main Street, near the bank."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Dinner must be finished before nine.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Don't worry. We'll finish by nine.",
                    "ok": true
                  },
                  {
                    "texto": "The weather is really bad tonight."
                  },
                  {
                    "texto": "I don't know where she went."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Can you bring the glasses?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  11
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Sure. I'll bring them now.",
                    "ok": true
                  },
                  {
                    "texto": "I've wanted it since March."
                  },
                  {
                    "texto": "Sure. Here's my phone number."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Thank you for your help today, Bryan."
              }
            ],

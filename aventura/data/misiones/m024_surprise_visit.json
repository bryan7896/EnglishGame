    {
      "id": "sala",
      "titulo": "The living room",
      "fondo": "sala_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "mom",
          "rol": "anfitrion",
          "auto": true,
          "pista": {
            "marca": "george"
          },
          "ocupado": [
            {
              "quien": "mom",
              "texto": "I need to get ready, Bryan!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "mom",
                "texto": "George! Linda! You're early! Bryan, why didn't you tell me?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  21
                ],
                "opciones": [
                  {
                    "texto": "I wanted to tell you, but you were cooking.",
                    "ok": true
                  },
                  {
                    "texto": "This morning it said sun. Now it says rain!"
                  },
                  {
                    "texto": "I'm going to study with you at the library."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Oh dear. The house isn't clean!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  35
                ],
                "opciones": [
                  {
                    "texto": "Don't worry. I'll clean while you finish dinner.",
                    "ok": true
                  },
                  {
                    "texto": "Oh no! I've broken one glass. I'm sorry!"
                  },
                  {
                    "texto": "When it gets dark, we'll use the fire."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Thank you. Please talk to them while I change."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  21
                ],
                "opciones": [
                  {
                    "texto": "Sure. I'll tell them about my new job.",
                    "ok": true
                  },
                  {
                    "texto": "Let's do the kitchen, then make the bed."
                  },
                  {
                    "texto": "Ha ha. You've never given me money before!"
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Can you do something for me?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  14
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Sure. I'll do the dishes later.",
                    "ok": true
                  },
                  {
                    "texto": "I've studied English for two years."
                  },
                  {
                    "texto": "Yes. Your dog runs very fast!"
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Good boy."
              }
            ]
          }
        },
        {
          "id": "george",
          "rol": "target",
          "antes": {
            "quien": "george",
            "texto": "Nice house, Bryan!"
          },
          "dialogo": {
            "requiere": "mom_hablado",
            "pasos": [
              {
                "quien": "george",
                "texto": "So, Bryan, your mom said you have a new job?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  40
                ],
                "opciones": [
                  {
                    "texto": "Yes. I've worked there for two months.",
                    "ok": true
                  },
                  {
                    "texto": "You too. I really like this hotel."
                  },
                  {
                    "texto": "I was walking home when it started."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Do you work during the holidays?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  40
                ],
                "opciones": [
                  {
                    "texto": "Only during the summer. Not in December.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I still hope they say yes."
                  },
                  {
                    "texto": "Yes. We only have a few eggs."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Good for you! When I was young, I worked while I studied."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  35
                ],
                "opciones": [
                  {
                    "texto": "Wow. I listen to music while I work.",
                    "ok": true
                  },
                  {
                    "texto": "If it were free, we would take it!"
                  },
                  {
                    "texto": "I'm looking for the man who sells fruit."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "What had you been doing before we arrived?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  1
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I had been cleaning the house all day.",
                    "ok": true
                  },
                  {
                    "texto": "If I were lost, I would ask somebody."
                  },
                  {
                    "texto": "Yes. We need to finish the design today."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "How long have you known Linda?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  34
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I've known her since she moved here.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. It's next to the bus stop."
                  },
                  {
                    "texto": "Yes, I've talked to him many times."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "What did you do over the holidays?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  52
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Over the holidays, I visited my friends.",
                    "ok": true
                  },
                  {
                    "texto": "Wow, half of them? That's a lot!"
                  },
                  {
                    "texto": "No, not yet. I've just got it!"
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "This is the lamp that I gave your mom.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  5
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Is it the lamp that was in your house?",
                    "ok": true
                  },
                  {
                    "texto": "Is it the figure that was in the glass box?"
                  },
                  {
                    "texto": "Great. Do I need a towel for the pool?"
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Dinner is ready! Come to the kitchen!"
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "cocina"
              }
            ]
          }
        }
      ],

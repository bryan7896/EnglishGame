          },
          "ocupado": [
            {
              "quien": "jake",
              "texto": "Help Tom, man!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "jake",
                "texto": "Finally! We've been walking for three hours!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  1
                ],
                "opciones": [
                  {
                    "texto": "We had been walking for hours. I'm tired!",
                    "ok": true
                  },
                  {
                    "texto": "Then somebody must be in the living room!"
                  },
                  {
                    "texto": "Yes. It's the oldest car on the street!"
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Why are you so tired? You walked less than me!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  1
                ],
                "opciones": [
                  {
                    "texto": "I had been working all week before this!",
                    "ok": true
                  },
                  {
                    "texto": "Don't worry. By Friday, everything will be ready."
                  },
                  {
                    "texto": "Good luck! Don't forget to bring it back."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Ha ha. Let's put the tent here. Take off your backpack."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  50
                ],
                "opciones": [
                  {
                    "texto": "OK. I'll take it off and put it down here.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, it was great, but the music was too loud."
                  },
                  {
                    "texto": "Thanks. All my friends have left. I need a taxi."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "How long are we staying here?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  40
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "For two nights. We can rest during the day.",
                    "ok": true
                  },
                  {
                    "texto": "No! It was very loud, but I loved it."
                  },
                  {
                    "texto": "I'm going to ask my dad for his car."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Next month, we'll have been doing this for five years!",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  44
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Wow! By then, we'll have been camping for five years!",
                    "ok": true
                  },
                  {
                    "texto": "Excuse me. I left my phone on a bus seat."
                  },
                  {
                    "texto": "If I won, I would buy you a new house."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "I cooked dinner badly last time.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  38
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Ha ha. It was really bad!",
                    "ok": true
                  },
                  {
                    "texto": "Yes. He lives near the park."
                  },
                  {
                    "texto": "Give me half of it, please!"
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Tom has the hand light, I think."
              }
            ]
          }
        },
        {
          "id": "tom",
          "rol": "target",
          "antes": {
            "quien": "tom",
            "texto": "One moment, Bryan!"
          },
          "pista": {
            "marca": "kenji"
          },
          "dialogo": {
            "requiere": "jake_hablado",
            "pasos": [
              {
                "quien": "tom",
                "texto": "Bryan, I can't find the hand light! It was in my bag while we were walking."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  35
                ],
                "opciones": [
                  {
                    "texto": "Maybe it fell out while we were walking.",
                    "ok": true
                  },
                  {
                    "texto": "I think there are a few sandwiches left."
                  },
                  {
                    "texto": "If I were lost, I would ask somebody."
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "Oh no! What do we do when it gets dark?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  35
                ],
                "opciones": [
                  {
                    "texto": "When it gets dark, we'll use the fire.",
                    "ok": true
                  },
                  {
                    "texto": "They'll answer by the end of the month."
                  },
                  {
                    "texto": "Ha ha. You've never given me money before!"
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "Good idea! Kenji is making the fire."
              },
              {
                "quien": "tom",
                "texto": "It's getting cold.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  30
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. And it's getting dark, too.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. The machine has my card."
                  },
                  {
                    "texto": "Oh! The letter has just arrived!"
                  }
                ]
              },
              {
                "quien": "tom",
                "texto": "Let's sit near the fire, then!",
                "refuerzo": true
              }
            ],
            "al_terminar": [
              {
                "luz": 0.2
              }
            ]
          }
        },
        {
          "id": "kenji",
          "rol": "target",
          "antes": {
            "quien": "kenji",
            "texto": "Wait, Bryan. I'm busy."
          },
          "dialogo": {
            "requiere": "tom_hablado",
            "pasos": [
              {
                "quien": "kenji",
                "texto": "Bryan, I'm cold. Can I try on your jacket?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  50
                ],
                "opciones": [
                  {
                    "texto": "Sure. Try it on. It's very warm.",
                    "ok": true
                  },
                  {
                    "texto": "Late. You had already played three songs."
                  },
                  {
                    "texto": "We had been walking in the park."
                  }
                ]
              },
              {
                "quien": "kenji",
                "texto": "Thank you. Listen! What were you doing when you heard that noise?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  35
                ],
                "opciones": [
                  {
                    "texto": "I was making the fire when I heard it.",
                    "ok": true
                  },
                  {
                    "texto": "But she loves our house. She always says that."
                  },
                  {
                    "texto": "It can't be the power. The lights are on."
                  }
                ]
              },
              {
                "quien": "kenji",
                "texto": "It was an owl! Ha ha. Before we came, I had been reading about owls."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  1
                ],
                "opciones": [
                  {
                    "texto": "Really? How long had you been reading?",
                    "ok": true
                  },
                  {
                    "texto": "Yes. Do you know where she went?"
                  },
                  {
                    "texto": "I paid online. That's strange, isn't it?"
                  }
                ]
              },
              {
                "quien": "kenji",
                "texto": "All week! Now let's lie down and look at the stars."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  50
                ],
                "opciones": [
                  {
                    "texto": "OK. Let's lie down near the fire.",
                    "ok": true
                  },
                  {
                    "texto": "The car stopped, so we got out."
                  },
                  {
                    "texto": "At five, I'll be eating ice cream."
                  }
                ]
              },
              {
                "quien": "kenji",
                "texto": "Is the fire too big?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  27
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "No, it's very big, but it's OK.",
                    "ok": true
                  },
                  {
                    "texto": "Let's make a list of the problems."
                  },
                  {
                    "texto": "OK. I'll take the bigger eggs, please."
                  }
                ]
              },
              {
                "quien": "kenji",
                "texto": "What had you been doing before I arrived?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  1
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I had been looking for wood.",
                    "ok": true
                  },
                  {
                    "texto": "I think he works every day."
                  },
                  {
                    "texto": "Cool! My uncle works there, too."
                  }
                ]
              },
              {
                "quien": "kenji",
                "texto": "This is the best night ever."
              }
            ],

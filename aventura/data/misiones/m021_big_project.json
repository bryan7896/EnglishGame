  "escenas": [
    {
      "id": "oficina",
      "titulo": "The office",
      "fondo": "oficina",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "clark",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "grace"
          },
          "ocupado": [
            {
              "quien": "clark",
              "texto": "Talk to Grace, Bryan. We need this by Friday."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "clark",
                "texto": "Bryan, we need the project by Friday."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "opciones": [
                  {
                    "texto": "By Friday? OK, it will be ready by then.",
                    "ok": true
                  },
                  {
                    "texto": "If you get lost again, I'll find you again!"
                  },
                  {
                    "texto": "As you can see, it's a very old car."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "How long will you have been working on it by Friday?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  44
                ],
                "opciones": [
                  {
                    "texto": "By Friday, I'll have been working on it for a month.",
                    "ok": true
                  },
                  {
                    "texto": "A letter from the university. I still hope it comes today."
                  },
                  {
                    "texto": "Yes. I think I had left my wallet on this table."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "Have you finished the first part yet?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  32
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes, I've already finished it.",
                    "ok": true
                  },
                  {
                    "texto": "Let's look for it together."
                  },
                  {
                    "texto": "Let's call the building manager."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "How long will you have been working here next month?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  44
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "By next month, I'll have been working here a year.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, a room that has a view of the sea."
                  },
                  {
                    "texto": "Mine is dead too. We have to find a taxi."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "What do you do on this project exactly?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  9
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I work as an engineer on this project.",
                    "ok": true
                  },
                  {
                    "texto": "We had been walking for hours. I'm tired!"
                  },
                  {
                    "texto": "I still hope I can see one song!"
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "OK. What do you need to finish it?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  6
                ],
                "opciones": [
                  {
                    "texto": "I need to talk to Grace about the design.",
                    "ok": true
                  },
                  {
                    "texto": "It can't be the power. The lights are on."
                  },
                  {
                    "texto": "Yes, but I played badly. It was very wet."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "Talk to her now."
              }
            ]
          }
        },
        {
          "id": "grace",
          "rol": "target",
          "antes": {
            "quien": "grace",
            "texto": "Hi, Bryan! I'm busy, one moment."
          },
          "pista": {
            "marca": "jake"
          },
          "dialogo": {
            "requiere": "clark_hablado",
            "pasos": [
              {
                "quien": "grace",
                "texto": "Hi, Bryan! Clark says you need help."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  6
                ],
                "opciones": [
                  {
                    "texto": "Yes. We need to finish the design today.",
                    "ok": true
                  },
                  {
                    "texto": "Perfect. By three, we will all be ready."
                  },
                  {
                    "texto": "Yes. It's the oldest car on the street!"
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "OK. Jake can help, too. He's very fast."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  44
                ],
                "opciones": [
                  {
                    "texto": "Good. By six, we'll have been working for ten hours!",
                    "ok": true
                  },
                  {
                    "texto": "If you cut the cake, we will stay all night!"
                  },
                  {
                    "texto": "OK. I'll take it off and put it down here."
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "Ha ha. Then let's order pizza by seven!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "opciones": [
                  {
                    "texto": "Good idea. And we can finish by midnight.",
                    "ok": true
                  },
                  {
                    "texto": "OK. I'll take my bag to the room."
                  },
                  {
                    "texto": "Yes. I still hope we can get there."
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "We must do a good job.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  14
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Don't worry. We'll do our best.",
                    "ok": true
                  },
                  {
                    "texto": "I had been looking for wood."
                  },
                  {
                    "texto": "Sure. I'll make you some soup."
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "By tonight, how long will we have been working?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  44
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "By tonight, we'll have been working for twelve hours.",
                    "ok": true
                  },
                  {
                    "texto": "I will. Thanks! I can't do anything without it."
                  },
                  {
                    "texto": "Me too! I was reading when I got on."
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "What have you done over the last two weeks?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  52
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Over the last two weeks, I made the design.",
                    "ok": true
                  },
                  {
                    "texto": "If you came with us, it would be fun!"
                  },
                  {
                    "texto": "Half of a spoon, two times a day. OK."
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "Talk to Jake. He's at his desk."
              }
            ]
          }
        },
        {
          "id": "jake",
          "rol": "target",
          "antes": {
            "quien": "jake",
            "texto": "Hey, Bryan! I'm on the phone."
          },
          "dialogo": {
            "requiere": "grace_hablado",
            "pasos": [
              {
                "quien": "jake",
                "texto": "Did someone say pizza? I'm in! When does Clark want the project?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "opciones": [
                  {
                    "texto": "He wants it by Friday morning.",
                    "ok": true
                  },
                  {
                    "texto": "OK. I'll take them off now."
                  },
                  {
                    "texto": "No, I haven't called him yet."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "No problem. What can I do?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  6
                ],
                "opciones": [
                  {
                    "texto": "You need to check these numbers.",
                    "ok": true
                  },
                  {
                    "texto": "I'm going to the train station."
                  },
                  {
                    "texto": "I know. They have just arrived!"
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Easy! By tomorrow, I'll have been working here for a year!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  44
                ],
                "opciones": [
                  {
                    "texto": "Ha ha. And I'll have been drinking coffee all night!",
                    "ok": true
                  },
                  {
                    "texto": "Only half of it? I'll go to the pharmacy now."
                  },
                  {
                    "texto": "Yes, I was listening to music when I got on."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "I'm getting really tired.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  30
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Me too. I'm getting hungry, too.",
                    "ok": true
                  },
                  {
                    "texto": "No, it stopped. It's sunny now."
                  },
                  {
                    "texto": "Because it's more fun with you!"
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Ha ha! Let's do it!"
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }

    {
      "id": "parada",
      "titulo": "At the bus stop",
      "fondo": "calle_lluvia",
      "musica": "street_loop",
      "personajes": [
        {
          "id": "emma",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "emma",
                "texto": "Oh dear, you two are very wet!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  27
                ],
                "opciones": [
                  {
                    "texto": "Yes. And it's very cold today.",
                    "ok": true
                  },
                  {
                    "texto": "The elevator door. It doesn't close."
                  },
                  {
                    "texto": "Good idea. I'll tell them everything."
                  }
                ]
              },
              {
                "quien": "emma",
                "texto": "The buses are late because of the rain."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  49
                ],
                "opciones": [
                  {
                    "texto": "Are they late because of the storm?",
                    "ok": true
                  },
                  {
                    "texto": "OK. Is the park on Main Street?"
                  },
                  {
                    "texto": "Great! And the steak? Is it ready yet?"
                  }
                ]
              },
              {
                "quien": "emma",
                "texto": "Yes. Oh, look! The rain stopped."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  33,
                  30
                ],
                "opciones": [
                  {
                    "texto": "Yes! It's getting better now.",
                    "ok": true
                  },
                  {
                    "texto": "Sure. Here's my phone number."
                  },
                  {
                    "texto": "They'll call me by Friday."
                  }
                ]
              },
              {
                "quien": "emma",
                "texto": "Take my umbrella anyway. Go home before you get sick."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  30
                ],
                "opciones": [
                  {
                    "texto": "Thanks, Emma. I don't want to get sick.",
                    "ok": true
                  },
                  {
                    "texto": "If I were lost, I would ask somebody."
                  },
                  {
                    "texto": "As you know, I always have a plan!"
                  }
                ]
              },
              {
                "quien": "emma",
                "texto": "You're welcome. Go, go!"
              }
            ],
            "al_terminar": [

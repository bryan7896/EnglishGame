          },
          "ocupado": [
            {
              "quien": "jake",
              "texto": "Come on, Bryan! The bus stop!"
            },
            {
              "quien": "jake",
              "texto": "Run, man! We're getting wet!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "jake",
                "texto": "Bryan! It's raining so hard! Where's your umbrella?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  49
                ],
                "opciones": [
                  {
                    "texto": "I didn't bring it because it was sunny.",
                    "ok": true
                  },
                  {
                    "texto": "Over the last month? Only food and books."
                  },
                  {
                    "texto": "Yes. I have a room for two nights."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Ha! Now you're getting wet."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  30
                ],
                "opciones": [
                  {
                    "texto": "I know. I'm getting cold, too.",
                    "ok": true
                  },
                  {
                    "texto": "I'll be waiting behind the door."
                  },
                  {
                    "texto": "Good idea. Buy some for her!"
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "And your shoes are full of water!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  27
                ],
                "opciones": [
                  {
                    "texto": "I know. It's too late to go back.",
                    "ok": true
                  },
                  {
                    "texto": "No, I think it's going to the airport."
                  },
                  {
                    "texto": "Sure. I'll tell them about my new job."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "What were you doing when it started to rain?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  35
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I was walking home when it started.",
                    "ok": true
                  },
                  {
                    "texto": "I've known her since she moved here."
                  },
                  {
                    "texto": "OK. I'll take the bigger eggs, please."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Let's go to the bus stop. Come on!"
              }
            ],

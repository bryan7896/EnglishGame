    {
      "id": "casa",
      "titulo": "Home",
      "fondo": "sala_dia",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "mom",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "mom",
                "texto": "Bryan! Look at you! Why are you so wet?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  49
                ],
                "opciones": [
                  {
                    "texto": "Because I forgot my umbrella this morning.",
                    "ok": true
                  },
                  {
                    "texto": "Sorry! It's too loud. I'll change it."
                  },
                  {
                    "texto": "At five, I'll be eating ice cream."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Take this towel. Do you want some hot tea?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  27
                ],
                "opciones": [
                  {
                    "texto": "Yes, please. But not too hot.",
                    "ok": true
                  },
                  {
                    "texto": "Practicing every day will help you."
                  },
                  {
                    "texto": "I'm going to bring the music."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Take off your wet shoes, please.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  50
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "OK. I'll take them off now.",
                    "ok": true
                  },
                  {
                    "texto": "OK. I'll put them down here."
                  },
                  {
                    "texto": "You need to check these numbers."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "If you don't dry your hair, you'll get sick.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  12
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "OK. If I dry it now, I'll be fine.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, I had heard about it from a friend."
                  },
                  {
                    "texto": "It can't be the power. The lights are on."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Here. Is it still raining outside?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  33
                ],
                "opciones": [
                  {
                    "texto": "No, it stopped. It's sunny now.",
                    "ok": true
                  },
                  {
                    "texto": "So the figure was returned! Great!"
                  },
                  {
                    "texto": "She told me nothing about moving."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Good. Next time, look at the weather before you go out."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  30
                ],
                "opciones": [
                  {
                    "texto": "I will. I don't want to get wet again.",
                    "ok": true
                  },
                  {
                    "texto": "Good. He can help us as fast as possible."
                  },
                  {
                    "texto": "Yes, corn for my dad. He cooks with us."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Did you play football in the rain?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  38
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes, but I played badly. It was very wet.",
                    "ok": true
                  },
                  {
                    "texto": "Can you finish by four? We'll wait for you."
                  },
                  {
                    "texto": "No. My card isn't working at the money machine."
                  }
                ]
              },
              {
                "quien": "mom",
                "texto": "Ha ha. Now drink your tea before it gets cold."
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }

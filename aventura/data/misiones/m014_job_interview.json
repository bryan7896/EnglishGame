    {
      "id": "entrevista",
      "titulo": "The interview",
      "fondo": "oficina",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "clark",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "clark",
                "texto": "Hello, Bryan. Please sit down. How long have you studied English?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  34
                ],
                "opciones": [
                  {
                    "texto": "I've studied English for two years.",
                    "ok": true
                  },
                  {
                    "texto": "Sure. I'll make you some soup."
                  },
                  {
                    "texto": "Yes, and it's really hot today."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "Good. And where do you work now?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  34
                ],
                "opciones": [
                  {
                    "texto": "I've worked at a small company since July.",
                    "ok": true
                  },
                  {
                    "texto": "I'm going to the bus stop, then home."
                  },
                  {
                    "texto": "As you can see, it's a very old car."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "Have you ever worked in a team?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  10
                ],
                "opciones": [
                  {
                    "texto": "Yes, I have worked in a team before.",
                    "ok": true
                  },
                  {
                    "texto": "I'm looking for the man who sells fruit."
                  },
                  {
                    "texto": "It's very cold, but you can swim."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "What do you do there?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  9
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I work as an engineer.",
                    "ok": true
                  },
                  {
                    "texto": "It's black, and it has no case."
                  },
                  {
                    "texto": "Tomorrow, I'll show you the city!"
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "And what did you do over the last year?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  52
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Over the last year, I learned a lot of English.",
                    "ok": true
                  },
                  {
                    "texto": "I was looking at my phone when it stopped."
                  },
                  {
                    "texto": "No. All the bags have gone, and mine isn't here."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "How long will you have been studying by next year?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  44
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "By next year, I'll have been studying for three years.",
                    "ok": true
                  },
                  {
                    "texto": "This morning it said sun. Now it says rain!"
                  },
                  {
                    "texto": "I'm going to ask my dad for his car."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "Why do you want to work here?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  18
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I'm interested in learning new things.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. He has taken the bus already."
                  },
                  {
                    "texto": "No, it isn't bad! You speak well."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "As a manager, I need people who work hard.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  9
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "As a student, I always worked hard.",
                    "ok": true
                  },
                  {
                    "texto": "It's on the left, near the stairs."
                  },
                  {
                    "texto": "Not many. Only a few cookies today."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "Do you have any questions for me?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  28
                ],
                "opciones": [
                  {
                    "texto": "Yes. Have you found other people for this job?",
                    "ok": true
                  },
                  {
                    "texto": "My card is in your machine. How can I get it back?"
                  },
                  {
                    "texto": "Me too! I was reading when I got on."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "We have talked to five people. Had you heard about our company before?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  28
                ],
                "opciones": [
                  {
                    "texto": "Yes, I had heard about it from a friend.",
                    "ok": true
                  },
                  {
                    "texto": "A tea, a sandwich and an orange juice, please."
                  },
                  {
                    "texto": "OK. We'll get off when the bus stops."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "Very good. We'll call you this week. Thank you for coming."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  34
                ],
                "opciones": [
                  {
                    "texto": "Thank you! I've waited for this day for a long time.",
                    "ok": true
                  },
                  {
                    "texto": "If I had more money, I would go to the beach."
                  },
                  {
                    "texto": "Oh no! I had missed the bus, so I walked."
                  }
                ]
              },
              {
                "quien": "clark",
                "texto": "Ha ha. Good luck, Bryan!"
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }
      ],

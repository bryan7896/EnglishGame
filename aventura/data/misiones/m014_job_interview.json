          "inicia_deshabilitado": true,
          "dialogo": {
            "requiere": "building",
            "pasos": [
              {
                "quien": "bryan",
                "reglaIds": [
                  34
                ],
                "opciones": [
                  {
                    "texto": "I've been ready since seven o'clock!",
                    "ok": true
                  },
                  {
                    "texto": "Yes. She speaks Spanish and English."
                  },
                  {
                    "texto": "I haven't opened it yet. Wait!"

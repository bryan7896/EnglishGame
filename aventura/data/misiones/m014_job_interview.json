    {
      "id": "recepcion",
      "titulo": "Reception",
      "fondo": "oficina",
      "musica": "home_loop",
      "personajes": [
        {
          "id": "grace",
          "rol": "anfitrion",
          "auto": true,
          "dialogo": {
            "pasos": [
              {
                "quien": "grace",
                "texto": "Good morning. Do you have an appointment?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  10
                ],
                "opciones": [
                  {
                    "texto": "Yes. I have just arrived for my interview.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. We need to finish the design today."
                  },
                  {
                    "texto": "Any time! Next time, bring pizza for us!"
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "Please write your name here.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  42
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Sure. Can I use your pen?",
                    "ok": true
                  },
                  {
                    "texto": "Look, the teacher has gone inside!"
                  },
                  {
                    "texto": "No. Nothing else has been taken."
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "Of course. Here you are. Please wait here."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  28
                ],
                "opciones": [
                  {
                    "texto": "Thank you. Has Mister Clark arrived yet?",
                    "ok": true
                  },
                  {
                    "texto": "We want to go to the university."
                  },
                  {
                    "texto": "I need help with my suitcase, please."
                  }
                ]
              },
              {
                "quien": "grace",
                "texto": "Yes, he has. He is ready for you. Come in, please."
              }
            ],
            "al_terminar": [
              {
                "ir_escena": "entrevista"
              }
            ]
          }
        }
      ],

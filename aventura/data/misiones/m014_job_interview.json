      "id": "calle",
      "titulo": "Interview day",
      "fondo": "ciudad_dia",
      "musica": "street_loop",
      "personajes": [
        {
          "id": "jake",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "building"
          },
          "ocupado": [
            {
              "quien": "jake",
              "texto": "Go, Bryan! Don't be late!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "jake",
                "texto": "Good luck today, Bryan! Have you prepared for the interview?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  10
                ],
                "opciones": [
                  {
                    "texto": "Yes, I have read about the company.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. We only have a few eggs."
                  },
                  {
                    "texto": "Look. Japan is in Asia, near China."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Great. How long have you wanted this job?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  34
                ],
                "opciones": [
                  {
                    "texto": "I've wanted it since March.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I'm looking for the bread."
                  },
                  {
                    "texto": "Great! I've never made pasta before."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Do you have the address?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  3
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Yes. It's next to the bus stop.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. She always drinks tea with milk."
                  },
                  {
                    "texto": "Then we need to study a lot!"
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "When will they tell you?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  48
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "They'll call me by Friday.",
                    "ok": true
                  },
                  {
                    "texto": "Oh no! I cooked it badly."
                  },
                  {
                    "texto": "Yes. He lives near the park."
                  }
                ]
              },
              {
                "quien": "jake",
                "texto": "Go! The building is over there."
              }
            ],
            "al_terminar": [
              {
                "habilita": "building"
              }
            ]
          }
        }
      ],
      "objetos": [

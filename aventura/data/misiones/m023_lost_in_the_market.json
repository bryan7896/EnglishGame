  "escenas": [
    {
      "id": "mercado",
      "titulo": "The market",
      "fondo": "mercado_dia",
      "musica": "street_loop",
      "personajes": [
        {
          "id": "rosa",
          "rol": "guia_inicial",
          "auto": true,
          "pista": {
            "marca": "pedro"
          },
          "ocupado": [
            {
              "quien": "rosa",
              "texto": "Pedro is at the end of the market!"
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "rosa",
                "texto": "Bryan! What are you looking for?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  23
                ],
                "opciones": [
                  {
                    "texto": "I'm looking for the man who sells fruit.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. I have a room for two nights."
                  },
                  {
                    "texto": "Don't worry. By Friday, everything will be ready."
                  }
                ]
              },
              {
                "quien": "rosa",
                "texto": "Pedro? I know him. Go to the end of the market."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  16
                ],
                "opciones": [
                  {
                    "texto": "Thanks! I'll go to the end now.",
                    "ok": true
                  },
                  {
                    "texto": "No, I have never waited this long."
                  },
                  {
                    "texto": "Sorry! It's too loud. I'll change it."
                  }
                ]
              },
              {
                "quien": "rosa",
                "texto": "And say hello to him from me!"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  8
                ],
                "opciones": [
                  {
                    "texto": "Sure. I'll say hello to him.",
                    "ok": true
                  },
                  {
                    "texto": "Sure. I'll buy it tomorrow morning."
                  },
                  {
                    "texto": "There's something soft... and a letter!"
                  }
                ]
              },
              {
                "quien": "rosa",
                "texto": "Does Pedro work every day?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  20
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "I think he works every day.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. The machine has my card."
                  },
                  {
                    "texto": "Yes. He lives near the park."
                  }
                ]
              },
              {
                "quien": "rosa",
                "texto": "Thanks!"
              }
            ]
          }
        },
        {
          "id": "george",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "george",
              "texto": "My wife loves honey."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "george",
                "texto": "Bryan! Look at this honey. Is it good?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  23
                ],
                "opciones": [
                  {
                    "texto": "Let me look at it. Yes, it's good!",
                    "ok": true
                  },
                  {
                    "texto": "He must be inside. He has a ticket."
                  },
                  {
                    "texto": "Maybe it fell out while we were walking."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "I'll buy it for my wife."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  8
                ],
                "opciones": [
                  {
                    "texto": "Good idea. Buy some for her!",
                    "ok": true
                  },
                  {
                    "texto": "Because you're sick? Stay in bed."
                  },
                  {
                    "texto": "It will be ready by four."
                  }
                ]
              },
              {
                "quien": "george",
                "texto": "Ha ha, I will!"
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        },
        {
          "id": "emma",
          "rol": "decoy",
          "ocupado": [
            {
              "quien": "emma",
              "texto": "Thank you, Bryan."
            }
          ],
          "dialogo": {
            "pasos": [
              {
                "quien": "emma",
                "texto": "Excuse me, can you help me? I'm lost."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  16
                ],
                "opciones": [
                  {
                    "texto": "Me too! I'm trying to get to the fruit.",
                    "ok": true
                  },
                  {
                    "texto": "Can you finish by four? We'll wait for you."
                  },
                  {
                    "texto": "No. My card isn't working at the money machine."
                  }
                ]
              },
              {
                "quien": "emma",
                "texto": "Oh, I'll go with you, then."
              }
            ],
            "al_terminar": [
              {
                "bloquear": true
              }
            ]
          }
        },
        {
          "id": "pedro",
          "rol": "target",
          "antes": {
            "quien": "pedro",
            "texto": "One moment, young man!"
          },
          "dialogo": {
            "requiere": "rosa_hablado",
            "pasos": [
              {
                "quien": "pedro",
                "texto": "Hello, young man! Fresh fruit! What do you need?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  8
                ],
                "opciones": [
                  {
                    "texto": "Hi! My mom sent me. The fruit is for her.",
                    "ok": true
                  },
                  {
                    "texto": "Yes, please. Bring it to the table by the window."
                  },
                  {
                    "texto": "Here it is. I've just found it in my bag."
                  }
                ]
              },
              {
                "quien": "pedro",
                "texto": "Ha ha, good boy. What does she want?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  23
                ],
                "opciones": [
                  {
                    "texto": "Bananas. Can you look for some good bananas?",
                    "ok": true
                  },
                  {
                    "texto": "Can you bring the lamp to the house?"
                  },
                  {
                    "texto": "No, I've never tried it. Is it good?"
                  }
                ]
              },
              {
                "quien": "pedro",
                "texto": "These bananas are cheaper than those.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  54
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "OK. I'll take the cheaper bananas.",
                    "ok": true
                  },
                  {
                    "texto": "OK. I won't make any noise."
                  },
                  {
                    "texto": "I've studied there since last year."
                  }
                ]
              },
              {
                "quien": "pedro",
                "texto": "Here. Anything else? Tomatoes, corn?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  8
                ],
                "opciones": [
                  {
                    "texto": "Yes, corn for my dad. He cooks with us.",
                    "ok": true
                  },
                  {
                    "texto": "That's right. And we still hope for next week!"
                  },
                  {
                    "texto": "Good. He can help us as fast as possible."
                  }
                ]
              },
              {
                "quien": "pedro",
                "texto": "This is the honey that my wife makes.",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  5
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "Is it the honey that George bought?",
                    "ok": true
                  },
                  {
                    "texto": "So the station is on the left?"
                  },
                  {
                    "texto": "How can we get to the university?"
                  }
                ]
              },
              {
                "quien": "pedro",
                "texto": "Yes! He loves it.",
                "refuerzo": true
              },
              {
                "quien": "pedro",
                "texto": "OK! That's six dollars. Where are you going after this?"
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  16
                ],
                "opciones": [
                  {
                    "texto": "I'm going to the bus stop, then home.",
                    "ok": true
                  },
                  {
                    "texto": "Sure. I'll tell them about my new job."
                  },
                  {
                    "texto": "Good idea. And we can finish by midnight."
                  }
                ]
              },
              {
                "quien": "pedro",
                "texto": "Where do you live?",
                "refuerzo": true
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  39
                ],
                "refuerzo": true,
                "opciones": [
                  {
                    "texto": "On Main Street, near the park.",
                    "ok": true
                  },
                  {
                    "texto": "Yes. And it's very cold today."
                  },
                  {
                    "texto": "No, I didn't ask anybody yet."
                  }
                ]
              },
              {
                "quien": "pedro",
                "texto": "Good. Be careful. The street is busy."
              },
              {
                "quien": "bryan",
                "reglaIds": [
                  23
                ],
                "opciones": [
                  {
                    "texto": "Thanks! The market looks like a big party!",
                    "ok": true
                  },
                  {
                    "texto": "Really? I thought you had gone in already."
                  },
                  {
                    "texto": "I didn't bring it because it was sunny."
                  }
                ]
              },
              {
                "quien": "pedro",
                "texto": "Ha ha! Come back soon!"
              }
            ],
            "al_terminar": [
              {
                "fin_mision": true
              }
            ]
          }
        }
      ],
